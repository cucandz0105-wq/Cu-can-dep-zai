        else 
            BtnPick.Text = "CHEST ONLY [OFF]" 
            TweenService:Create(BtnPick, TweenInfo.new(0.2), {BackgroundColor3 = Color3.fromRGB(45, 45, 45)}):Play() 
            StopBot() 
        end
    end)
