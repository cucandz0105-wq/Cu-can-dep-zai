    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    if hrp then
        SavedCFrame = hrp.CFrame
        LockButton.Text = "✅ Đã Ghim Tọa Độ Thuyền!"
        LockButton.BackgroundColor3 = Color3.fromRGB(0, 100, 0)
        task.wait(1)
        LockButton.Text = "📍 Cập Nhật Lại Vị Trí Thuyền"
    end
end)

local function OnCharacterChildAdded(child)
    if not _G.SyncDropActive or not SavedCFrame then return end
    if child:IsA("Tool") or child:IsA("Model") then
        local char = LocalPlayer.Character
        local hrp = char and char:FindFirstChild("HumanoidRootPart")
        if hrp then
            local oldCFrame = hrp.CFrame
            local targetCFrame = SavedCFrame * CFrame.new(0, 2.5, 0) 
            local isDropping = true
            local connection
            connection = RunService.Heartbeat:Connect(function()
                if isDropping then
                    hrp.CFrame = targetCFrame
                    hrp.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
                    hrp.AssemblyAngularVelocity = Vector3.new(0, 0, 0)
                else
                    connection:Disconnect()
                end
            end)
            task.wait(0.12)
            pcall(function() DropRemote:FireServer() end)
            task.wait(0.08)
            isDropping = false
            pcall(function()
                hrp.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
                hrp.AssemblyAngularVelocity = Vector3.new(0, 0, 0)
                hrp.CFrame = oldCFrame
            end)
        end
    end
end

local function SetupCharacterConnection(char)
    if char then char.ChildAdded:Connect(OnCharacterChildAdded) end
end
LocalPlayer.CharacterAdded:Connect(SetupCharacterConnection)
if LocalPlayer.Character then SetupCharacterConnection(LocalPlayer.Character) end

