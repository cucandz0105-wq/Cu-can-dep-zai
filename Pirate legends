-- 🛰️ HÀM CẤY KHÓA CHỐNG TRANH CHẤP MẠNG (Chở nhiều người nút thảm vẫn chạy ngầm)
local function assignBoatToGroup(seat)
    local boat = seat.Parent
    if boat then
        for _, part in pairs(boat:GetDescendants()) do
            if part:IsA("BasePart") and part.Name ~= "RealNeonBottomCarpet" then
                pcall(function() 
                    part.CollisionGroup = "PlayerBoatGroup"
                    -- Ép NetworkOwner liên tục về máy mình nếu có người khác trèo lên làm nhiễu vật lý
                    if part.ReceiveAge > 0.1 or part:GetNetworkOwner() ~= LocalPlayer then
                        if part:CanSetNetworkOwnership() then
                            part:SetNetworkOwner(LocalPlayer)
                        end
                    end
                end)
            end
        end
    end
end

RunService.PreSimulation:Connect(function()
    local seat = getDrivenSeat()
    if seat then
        assignBoatToGroup(seat)
        
        if _G.BoatFlyActive then
            local currentBottomY = getAbsoluteBoatBottom(seat)
            
            if not _G.BaseFloatLevel then 
                _G.BaseFloatLevel = currentBottomY - 2
            end
            
            local targetCarpetY = _G.BaseFloatLevel + _G.ManualOffset
            
            if targetCarpetY > (currentBottomY - 1.2) then
                targetCarpetY = currentBottomY - 1.2
            end
            
            if HeightLabel then HeightLabel.Text = "Cao độ thảm Y: " .. tostring(math.floor(targetCarpetY)) end
            
            if not RealCarpet then 
                createRealCarpet() 
            end
            
            -- LERP mượt trục Y theo tàu, triệt tiêu gia tốc thừa chống rung giật
            local targetCFrame = CFrame.new(seat.Position.X, targetCarpetY, seat.Position.Z)
            RealCarpet.CFrame = RealCarpet.CFrame:Lerp(targetCFrame, 0.25)
        else
            if RealCarpet then RealCarpet:Destroy() RealCarpet = nil end
            if _G.BaseFloatLevel then if HeightLabel then HeightLabel.Text = "Độ Cao Thảm: Tắt" end _G.BaseFloatLevel = nil end
        end

        if _G.SuperSailActive then
            if not activeAttachment or activeAttachment.Parent ~= seat then
                if activeAttachment then activeAttachment:Destroy() end
                activeAttachment = Instance.new("Attachment")
                activeAttachment.Parent = seat
            end
            if not activeVelocity or activeVelocity.Parent ~= seat then
                if activeVelocity then activeVelocity:Destroy() end
                activeVelocity = Instance.new("LinearVelocity")
                activeVelocity.Attachment0 = activeAttachment
                activeVelocity.MaxForce = math.huge
                activeVelocity.VelocityConstraintMode = Enum.VelocityConstraintMode.Vector
                activeVelocity.Parent = seat
            end
            local forward = seat.CFrame.LookVector
            activeVelocity.VectorVelocity = Vector3.new(forward.X, 0, forward.Z).Unit * _G.BoostMultiplier
        else
            if activeVelocity then activeVelocity:Destroy() activeVelocity = nil end
        end
    else
        cleanUpForces()
        _G.BaseFloatLevel = nil
        if HeightLabel then HeightLabel.Text = "Độ Cao Thảm: Tắt" end
    end
end)

