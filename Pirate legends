local function CheckPromptLogic(pmt)
    if not pmt.Enabled then return end local char, pObj = LocalPlayer.Character, pmt.Parent local hrp = char and char:FindFirstChild("HumanoidRootPart") if not hrp or not pObj then return end
    local act, name = string.lower(pmt.ActionText), string.lower(pObj.Name)
    local isBaseTeleport = false
    pcall(function()
        if string.find(name, "tobase") or string.find(act, "căn cứ") or string.find(act, "can cu") then
            if pObj:FindFirstAncestor("SpiritTeleport") or pObj:FindFirstAncestor("Ferryman's Galleon") then isBaseTeleport = true end
        end
    end)
    if isBaseTeleport then FirePrompt(pmt) return end
    local isDig = string.find(act, "dig") or string.find(act, "dao") if isDig and (IsHoldingChest() or _G.IsDigging) then return end
    local isQuestPrompt = string.find(act, "nhiem vu") or string.find(act, "quest") or string.find(act, "tham hiem") or string.find(act, "chuyen")
    if _G.AutoChestOnly and isQuestPrompt then return end
    local valid = false local pPos = pObj:IsA("Model") and pObj:GetPivot().Position or (pObj:IsA("BasePart") and pObj.Position) if pPos and (hrp.Position - pPos).Magnitude <= 14 then valid = true end
    if not valid then
        if pObj.Name == "Sell" or (pObj.Parent and pObj.Parent.Name == "GoldenPioneerNPC") or string.find(act, "sell") or string.find(act, "ban") then valid = true
        elseif isQuestPrompt then if not HasHolesOnMap() then valid = true end end
        if string.find(name, "chest") or string.find(name, "ruong") or string.find(name, "buried") or isDig or string.find(act, "open") or string.find(act, "nhat") or string.find(act, "claim") or string.find(act, "collect") or string.find(act, "mang theo") or string.find(act, "carry") then valid = true end
    end
    if valid then FirePrompt(pmt) if isQuestPrompt or pObj.Name == "GoldenPioneerNPC" or (pObj.Parent and pObj.Parent.Name == "GoldenPioneerNPC") then task.spawn(AutoBuyQuestFromStore) end end
end

