local function updateStatusText()
    if #TargetKeywords > 0 then
        StatusLabel.Text = "🔒 Đang ép đạn đón đầu mục tiêu chỉ định!"
        StatusLabel.TextColor3 = Color3.fromRGB(255, 50, 50)
    elseif NpcScanningEnabled then
        StatusLabel.Text = "⚡ Quét tự do: Bắn mọi thứ gần tâm"
        StatusLabel.TextColor3 = Color3.fromRGB(0, 255, 100)
    else
        StatusLabel.Text = "👤 Quét tự do: Chỉ nhắm mục tiêu Người"
        StatusLabel.TextColor3 = Color3.fromRGB(100, 200, 255)
    end
end

local function updateTargets()
    TargetKeywords = {}
    for segment in string.gmatch(TextBox.Text, "([^,]+)") do
        local clean = string.gsub(segment, "^%s*(.-)%s*$", "%1")
        if clean ~= "" then table.insert(TargetKeywords, string.lower(clean)) end
    end
    updateStatusText()
end

TextBox:GetPropertyChangedSignal("Text"):Connect(updateTargets)
ClearBtn.MouseButton1Click:Connect(function() TextBox.Text = "" updateTargets() end)

NpcToggleBtn.MouseButton1Click:Connect(function()
    NpcScanningEnabled = not NpcScanningEnabled
    NpcToggleBtn.Text = NpcScanningEnabled and "👾 NPC QUÉT: BẬT" or "👾 NPC QUÉT: TẮT"
    NpcToggleBtn.BackgroundColor3 = NpcScanningEnabled and Color3.fromRGB(10, 40, 10) or Color3.fromRGB(40, 10, 10)
    NpcToggleBtn.BorderColor3 = NpcScanningEnabled and Color3.fromRGB(0, 255, 100) or Color3.fromRGB(255, 50, 50)
    NpcToggleBtn.TextColor3 = NpcScanningEnabled and Color3.fromRGB(0, 255, 100) or Color3.fromRGB(255, 80, 80)
    updateStatusText()
end)

local function isTargetInList(player)
    if not player or #TargetKeywords == 0 then return false end
    local name, displayName, id = string.lower(player.Name), string.lower(player.DisplayName), tostring(player.UserId)
    for _, keyword in ipairs(TargetKeywords) do
        if keyword ~= "" and (string.find(name, keyword, 1, true) or string.find(displayName, keyword, 1, true) or id == keyword) then return true end
    end
    return false
end

local function isPartVisible(part, character)
    local origin = Camera.CFrame.Position
    local direction = (part.Position - origin).Unit * (part.Position - origin).Magnitude
    local raycastParams = RaycastParams.new()
    raycastParams.FilterType = Enum.RaycastFilterType.Exclude
    raycastParams.FilterDescendantsInstances = {LocalPlayer.Character, character, Workspace.CurrentCamera}
    raycastParams.IgnoreWater = true
    return Workspace:Raycast(origin, direction, raycastParams) == nil
end

local function getVisiblePartFromModel(model, isCloseRange)
    if not model then return nil end
    if isCloseRange then return model:FindFirstChild("HumanoidRootPart") or model:FindFirstChild("Torso") end
    for _, partName in ipairs({"HumanoidRootPart", "UpperTorso", "Torso", "Head"}) do
        local part = model:FindFirstChild(partName)
        if part and isPartVisible(part, model) then return part end
    end
    return nil
end

local function getClosestTargetModel()
    local character = LocalPlayer.Character
    if not character then return nil end
    local closestModel = nil
    local minMouseDist = math.huge

    if #TargetKeywords > 0 then
        for _, p in pairs(Players:GetPlayers()) do
            if p ~= LocalPlayer and isTargetInList(p) and p.Character and p.Character:FindFirstChild("Humanoid") and p.Character.Humanoid.Health > 0 then
                local root = p.Character:FindFirstChild("HumanoidRootPart")
                if root then
                    local screenPos, onScreen = Camera:WorldToViewportPoint(root.Position)
                    if onScreen then
                        local dist = (Vector2.new(screenPos.X, screenPos.Y) - (Camera.ViewportSize / 2)).Magnitude
                        if dist < minMouseDist then minMouseDist = dist closestModel = p.Character end
                    end
                end
            end
        end
        return closestModel
    end

    for _, obj in pairs(Workspace:GetDescendants()) do
        if obj:IsA("Model") and obj ~= character and obj:FindFirstChild("Humanoid") and obj.Humanoid.Health > 0 then
            local p = Players:GetPlayerFromCharacter(obj)
            if (p and p ~= LocalPlayer) or (not p and NpcScanningEnabled) then
                local root = obj:FindFirstChild("HumanoidRootPart") or obj:FindFirstChild("Torso")
                if root then
                    local screenPos, onScreen = Camera:WorldToViewportPoint(root.Position)
                    if onScreen then
                        local dist = (Vector2.new(screenPos.X, screenPos.Y) - (Camera.ViewportSize / 2)).Magnitude
                        if dist < minMouseDist then minMouseDist = dist closestModel = obj end
                    end
                end
            end
        end
    end
    return closestModel
end

local function findRangedTool()
    local char = LocalPlayer.Character
    if not char then return nil end
    for _, name in ipairs({"Từ xa", "Ranged", "Súng", "Gun"}) do
        local tool = char:FindFirstChild(name) or LocalPlayer.Backpack:FindFirstChild(name)
        if tool and tool:IsA("Tool") and tool:FindFirstChild("ToolFolder") then return tool end
    end
    return nil
end

task.spawn(function()
    while task.wait(0.03) do
        for _, p in pairs(Players:GetPlayers()) do
            if p.Character and p.Character:FindFirstChild("HumanoidRootPart") then
                local root = p.Character.HumanoidRootPart
                if not LastPositions[p.UserId] then
                    LastPositions[p.UserId] = {Pos = root.Position, Time = os.clock()}
                else
                    local oldData = LastPositions[p.UserId]
                    local dt = os.clock() - oldData.Time
                    if dt > 0 then
                        LastPositions[p.UserId] = {Pos = root.Position, Time = os.clock(), Vel = (root.Position - oldData.Pos) / dt}
                    end
                end
            end
        end
    end
end)

AimBtn.MouseButton1Click:Connect(function()
    local char = LocalPlayer.Character
    local root = char and char:FindFirstChild("HumanoidRootPart")
    if not char or not root then return end

    local rangedTool = findRangedTool()
    if not rangedTool then
        AimBtn.Text = "❌\nNO GUN" task.wait(0.2) AimBtn.Text = "🎯\nHYPER AIM\nv12.1" return
    end

    local remotes = rangedTool.ToolFolder.Remotes
    local aimRemote, fireRemote = remotes:FindFirstChild("Aim"), remotes:FindFirstChild("Fire")
    if not aimRemote or not fireRemote then return end

    local targetModel = getClosestTargetModel()
    if targetModel then
        local tRoot = targetModel:FindFirstChild("HumanoidRootPart") or targetModel:FindFirstChild("Torso")
        local distance = tRoot and (tRoot.Position - root.Position).Magnitude or 999
        local targetPart = getVisiblePartFromModel(targetModel, (distance <= 15))
        
        if targetPart then
            local targetPosition = targetPart.Position
            local pTarget = Players:GetPlayerFromCharacter(targetModel)
            if pTarget and LastPositions[pTarget.UserId] and LastPositions[pTarget.UserId].Vel then
                local realVel = LastPositions[pTarget.UserId].Vel
                local pFactor = math.clamp(0.075 + (distance * 0.0018), 0.075, 0.25)
                targetPosition = targetPosition + (realVel * pFactor)
            end
            aimRemote:FireServer()
            fireRemote:FireServer(targetPosition)
            AimBtn.TextColor3 = Color3.fromRGB(0, 255, 0) task.wait(0.01) AimBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
        else
            AimBtn.Text = "🧱\nWALL BLOCKED" task.wait(0.2) AimBtn.Text = "🎯\nHYPER AIM\nv12.1"
        end
    else
        AimBtn.Text = "🔍\nNO TARGET" task.wait(0.15) AimBtn.Text = "🎯\nHYPER AIM\nv12.1"
    end
end)
