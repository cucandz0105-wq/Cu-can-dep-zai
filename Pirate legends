                end
            end
            
            if not _G.IsTeleportingHome and not tPos then
                if IsHoldingChest() then npc = GetNearestSeller() if npc then tPos, toSeller = npc:GetPivot().Position, true tPart = npc end
                else tPart = _G.AutoChestOnly and GetNearestDroppedChest() or (_G.AutoDigAndPick and (GetChestAtFeet() or GetNearestBuriedChest())) if tPart then tPos = tPart.Position else npc = GetNearestSeller() if npc then tPos, toSeller = npc:GetPivot().Position, true tPart = npc elseif gd and distToDoor > 200 then ghostDoor = gd tPos = gd:GetPivot().Position tPart = gd end end end
            end
            
            if not tPos then 
                _G.CurrentTarget = nil _G.FakeFallSpeed = 0 
                hrp.AssemblyLinearVelocity, hrp.AssemblyAngularVelocity = Vector3.new(0,0,0), Vector3.new(0,0,0) 
                hrp.Anchored = false 
                return 
            end
            hrp.AssemblyLinearVelocity, hrp.AssemblyAngularVelocity = Vector3.new(0,0,0), Vector3.new(0,0,0)
            
            -- ĐIỀU KIỆN NHẢ ANCHOR KHI MỤC TIÊU ĐÃ ĐƯỢC THAY ĐỔI / BIẾN MẤT
            if _G.CurrentTarget ~= tPart then 
                hrp.Anchored = false -- Nhả Neo ngay lập tức để bay sang mục tiêu mới
                _G.CurrentTarget = tPart 
                _G.StuckTime = os.clock() 
                _G.SellerStuckTime = nil 
                _G.DaDenDich = false
                _G.IsEscapingStuck = false 
                _G.TimeAfterTP = nil 
                _G.TimeAtTarget = nil 
                isInteracting = false
            end
             -- =======================================================
            -- ANTI-RUBBERBAND SYSTEM (Giữ nguyên)
            -- =======================================================
            if not _G.LastHrpPosition then 
                _G.LastHrpPosition = hrp.Position
                _G.RubberbandCount = 0
                _G.LastRubberbandTime = os.clock()
            end

            if os.clock() - _G.LastRubberbandTime > 3.0 then
                _G.RubberbandCount = 0
            end

            local currentDistToTarget = (hrp.Position - tPos).Magnitude
            local lastDistToTarget = (_G.LastHrpPosition - tPos).Magnitude

            if (currentDistToTarget - lastDistToTarget) > 10.0 then
                _G.RubberbandCount = _G.RubberbandCount + 1
                _G.LastRubberbandTime = os.clock()
                
                if _G.RubberbandCount >= 8 then 
                    if char and hum and hum.Health > 0 then 
                        hrp.Anchored = false
                        hum.Health = 0 
                    end
                    _G.RubberbandCount = 0
                    _G.LastHrpPosition = hrp.Position
                    return
                end
            end
            _G.LastHrpPosition = hrp.Position
            -- =======================================================
            
            local dist = (hrp.Position - tPos).Magnitude if toSeller and dist < 18 then Camera.CFrame = CFrame.new(Camera.CFrame.Position, tPos) end
            local dir = (tPos - hrp.Position).Unit local stopPos, sellerY_Chuan = tPos - (dir * OFFSET_DIST), tPos.Y
            if toSeller and npc then local sHrp = npc:FindFirstChild("HumanoidRootPart") or npc:FindFirstChildWhichIsA("BasePart") if sHrp then local lVec = sHrp.CFrame.LookVector sellerY_Chuan = sHrp.Position.Y stopPos = Vector3.new(tPos.X + (lVec.X * OFFSET_DIST), sellerY_Chuan, tPos.Z + (lVec.Z * OFFSET_DIST)) dist = (hrp.Position - stopPos).Magnitude + OFFSET_DIST end 
            elseif ghostDoor then sellerY_Chuan = tPos.Y stopPos = tPos - (dir * OFFSET_DIST) end
            local stopLimit = (toSeller or ghostDoor) and (OFFSET_DIST + 1.2) or (OFFSET_DIST + 0.5)
            
            -- =======================================================================
            -- CHU KỲ ĐỘT TỬ ĐỘC LẬP TỰ DO (Giữ nguyên)
            -- =======================================================================
            local notNpcOrDoor = (not toSeller) and (not ghostDoor)
            local pGui = LocalPlayer:FindFirstChildWhichIsA("PlayerGui")
            local isQuestMenuOpen = false

            if pGui then
                local shopUI = pGui:FindFirstChild("QuestShopUI")
                local pickUI = pGui:FindFirstChild("PickQuestUI")
                if (shopUI and (shopUI:GetAttribute("Enabled") or shopUI.Enabled)) or 
                   (pickUI and (pickUI:GetAttribute("Enabled") or pickUI.Enabled)) then
                    isQuestMenuOpen = true
                end
            end

            if notNpcOrDoor and not isQuestMenuOpen and _G.IsEscapingStuck and _G.TimeAfterTP then
                local elapsedAfterTP = os.clock() - _G.TimeAfterTP
                if elapsedAfterTP >= 2.0 then
                    if char and hum and hum.Health > 0 then 
                        hrp.Anchored = false
                        hum.Health = 0 
                    end
                    _G.IsEscapingStuck = false 
                    _G.TimeAfterTP = nil
                    _G.TimeAtTarget = nil
                    return 
                end
            end

            if toSeller then
                local shouldCheckStuck = false
                if _G.AutoDigAndPick then
                    shouldCheckStuck = IsHoldingChest() or (not isQuestMenuOpen)
                elseif _G.AutoChestOnly then
                    shouldCheckStuck = IsHoldingChest()
                end

                if shouldCheckStuck then
                    if dist < 15 then
                        if not _G.SellerStuckTime then
                            _G.SellerStuckTime = os.clock()
                        elseif (os.clock() - _G.SellerStuckTime) >= 3.0 then
                            if char and hum and hum.Health > 0 then 
                                hrp.Anchored = false
                                hum.Health = 0 
                            end
                            _G.SellerStuckTime = nil
                            return
                        end
                    end
                else
                    _G.SellerStuckTime = nil
                end
            else
                _G.SellerStuckTime = nil
            end
            -- =======================================================================

            if dist <= stopLimit then
                _G.DaDenDich = true
                if not _G.TimeAtTarget then _G.TimeAtTarget = os.clock() end
                local elapsedAtTarget = os.clock() - _G.TimeAtTarget

                if notNpcOrDoor and not isQuestMenuOpen and not _G.IsEscapingStuck then
                    if elapsedAtTarget < 0.01 then -- Giữ mốc siêu tốc của bro
                        hrp.Anchored = true
                    else
                        hrp.Anchored = false 
                    end
                end

                AutoTriggerPrompt(tPart)

                local safeY = tPos.Y + (hrp.Size.Y / 2) + 2.5

                if notNpcOrDoor and not isQuestMenuOpen then
                    if elapsedAtTarget >= 2.0 and not _G.IsEscapingStuck and hrp.Position.Y < safeY - 0.1 then 
                        _G.IsEscapingStuck = true
                        _G.TimeAfterTP = os.clock() 
                    end
                end

                if _G.IsEscapingStuck then
                    if hrp.Position.Y < safeY then
                        local newY = hrp.Position.Y + (60 * dt)
                        if newY > safeY then newY = safeY end
                        hrp.CFrame = CFrame.new(Vector3.new(hrp.Position.X, newY, hrp.Position.Z), Vector3.new(tPos.X, newY, tPos.Z))
                    else
                        hrp.CFrame = CFrame.new(Vector3.new(hrp.Position.X, safeY, hrp.Position.Z), Vector3.new(tPos.X, safeY, tPos.Z))
                    end
                else
                    if elapsedAtTarget < 2.0 or toSeller or ghostDoor then
                        local finalStopPos = Vector3.new(stopPos.X, (toSeller or ghostDoor) and stopPos.Y or (tPos.Y + (hrp.Size.Y / 2) + 1.8), stopPos.Z)
                        hrp.CFrame = CFrame.new(finalStopPos, Vector3.new(tPos.X, finalStopPos.Y, tPos.Z)) 
                    end
                end
            else
                hrp.Anchored = false
                _G.TimeAtTarget = nil 
                
                if _G.IsEscapingStuck and dist > 15 then
                    _G.IsEscapingStuck = false
                    _G.TimeAfterTP = nil
                end
                
                local moveDir = (toSeller or ghostDoor) and (stopPos - hrp.Position).Unit or dir 
                local clampledSpeed = math.min(FLY_SPEED * dt, 2.3) 
                
                local nextPos
                if _G.IsEscapingStuck then
                    nextPos = hrp.Position 
                else
                    nextPos = hrp.Position + (moveDir * clampledSpeed)
                end
                
                local inCave = (not toSeller) and (not ghostDoor) and (tPos.Y < 20) 
                local targetY, groundY, trenBien = hrp.Position.Y, nil, false 
                local ganMucTieu = dist < 30
                
                if ganMucTieu then 
                    if _G.IsEscapingStuck then
                        targetY = tPos.Y + (hrp.Size.Y / 2) + 2.5
                    else
                        targetY = (toSeller or ghostDoor) and sellerY_Chuan or (tPos.Y + (hrp.Size.Y / 2) + 1.8) 
                    end
                    nextPos = Vector3.new(nextPos.X, hrp.Position.Y, nextPos.Z)
                elseif not inCave then
                    local params = RaycastParams.new() params.FilterType = Enum.RaycastFilterType.Exclude local ignore = {char}
                    if Workspace:FindFirstChild("IslandsModel") and Workspace["IslandsModel"]:FindFirstChild("NPCs") then table.insert(ignore, Workspace["IslandsModel"]["NPCs"]) end
                    if Workspace:FindFirstChild("Trees") then table.insert(ignore, Workspace["Trees"]) end if Workspace:FindFirstChild("TreeFolder") then table.insert(ignore, Workspace["TreeFolder"]) end
                    params.FilterDescendantsInstances = ignore 
                    
                    local ray = Workspace:Raycast(Vector3.new(nextPos.X, nextPos.Y + 100, nextPos.Z), Vector3.new(0, -250, 0), params)
                    if ray and ray.Instance then 
                        groundY = ray.Position.Y 
                        targetY = groundY + (hrp.Size.Y / 2) + 0.01 
                        if tPos.Y < hrp.Position.Y - 5 and targetY > tPos.Y + 10 then 
                            targetY = tPos.Y + (hrp.Size.Y / 2) + 0.01 
                        end 
                    else 
                        targetY, trenBien = SEA_LEVEL, true 
                    end
                else 
                    targetY = math.max(tPos.Y + (hrp.Size.Y / 2) + 0.01, -30) 
                end
                
                -- =======================================================
                -- HẠ ĐỘ CAO VÀ PHANH TRÊN BIỂN/ĐẤT LIỀN
                -- =======================================================
                local finalY = hrp.Position.Y
                if trenBien and not ganMucTieu then 
                    if hrp.Position.Y > SEA_LEVEL then 
                        _G.FakeFallSpeed = _G.FakeFallSpeed + (workspace.Gravity * dt) 
                        if _G.FakeFallSpeed > 110 then _G.FakeFallSpeed = 110 end 
                        
                        local deltaY = _G.FakeFallSpeed * dt
                        
                        -- Phanh khống chế trên biển (Max 1.2 studs/frame để lướt chéo từ từ)
                        local maxRoiTrenBien = 1.2 
                        if deltaY > maxRoiTrenBien then 
                            deltaY = maxRoiTrenBien 
                        end
                        
                        finalY = hrp.Position.Y - deltaY
                        if finalY < SEA_LEVEL then finalY, _G.FakeFallSpeed = SEA_LEVEL, 0 end 
                    else 
                        finalY, _G.FakeFallSpeed = SEA_LEVEL, 0 
                    end
                else 
                    _G.FakeFallSpeed = 0 
                    if targetY < hrp.Position.Y - 2 then 
                        -- ÁP DỤNG PHANH HÃM FRAME KHI XUỐNG DỐC / LAO VỰC ĐỘT NGỘT
                        local duKienY = hrp.Position.Y - (FALL_LIMIT * dt)
                        
                        -- Phanh khống chế: Mỗi khung hình chỉ cho phép tụt tối đa 1.5 studs
                        local maxRoiMoiFrame = 1.5 
                        if (hrp.Position.Y - duKienY) > maxRoiMoiFrame then
                            duKienY = hrp.Position.Y - maxRoiMoiFrame
                        end
                        
                        if duKienY < targetY then duKienY = targetY end
                        finalY = duKienY
                    elseif targetY > hrp.Position.Y + 2 then 
                        local tocDoClimb = ganMucTieu and 35 or (CLIMB_LIMIT + 20)
                        local duKienLenY = hrp.Position.Y + (tocDoClimb * dt)
                        
                        local limitFrameY = 1.0
                        if ganMucTieu or (targetY - hrp.Position.Y) > 15 then
                            limitFrameY = 2.5
                        end
                        
                        if (duKienLenY - hrp.Position.Y) > limitFrameY then 
                            duKienLenY = hrp.Position.Y + limitFrameY 
                        end 
                        
                        finalY = duKienLenY
                        if finalY > targetY then finalY = targetY end 
                    else 
                        finalY = hrp.Position.Y + (targetY - hrp.Position.Y) * LERP_SMOOTH 
                    end 
                end
                
                if groundY and (finalY - groundY > MAX_HEIGHT) and not ganMucTieu then finalY = groundY + MAX_HEIGHT end
                finalY = math.max(finalY, -30)
                if (Vector3.new(tPos.X, finalY, tPos.Z) - Vector3.new(nextPos.X, finalY, nextPos.Z)).Magnitude > 0.1 then 
                    hrp.CFrame = CFrame.new(Vector3.new(nextPos.X, finalY, nextPos.Z), Vector3.new(tPos.X, finalY, tPos.Z))
                else 
                    hrp.CFrame = CFrame.new(Vector3.new(nextPos.X, finalY, nextPos.Z), nextPos.X + hrp.CFrame.LookVector) 
                end
            end
        end
    end)
end

-- =======================================================
-- HÀM DỪNG BOT & KHÔI PHỤC TRẠNG THÁI (Giữ nguyên)
-- =======================================================
local function StopBot()
    if not _G.AutoDigAndPick and not _G.AutoChestOnly then
        if _G.BotConnection then _G.BotConnection:Disconnect() _G.BotConnection = nil end 
        if _G.NoclipConnection then _G.NoclipConnection:Disconnect() _G.NoclipConnection = nil end
        if LocalPlayer.Character then 
            local hum = LocalPlayer.Character:FindFirstChildWhichIsA("Humanoid") 
            if hum then 
                hum:ChangeState(Enum.HumanoidStateType.GettingUp) 
                hum:SetStateEnabled(Enum.HumanoidStateType.Seated, true) 
            end 
            local hrp = LocalPlayer.Character:FindFirstChild("HumanoidRootPart") 
            if hrp then 
                hrp.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
                hrp.AssemblyAngularVelocity = Vector3.new(0, 0, 0)
                task.wait(0.05)
                hrp.Anchored = false 
                hrp.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
            end 
        end
        _G.IsDigging, _G.FakeFallSpeed, _G.CurrentTarget, _G.StuckTime, _G.IsTeleportingHome = false, 0, nil, 0, false
        _G.DaDenDich = false
        _G.SellerStuckTime = nil
        _G.LastHrpPosition = nil
        _G.RubberbandCount = 0
        _G.IsEscapingStuck = false
        _G.TimeAfterTP = nil
        _G.TimeAtTarget = nil
        isInteracting = false
    end
end

