local function getDrivenSeat()
    local char = LocalPlayer.Character
    if not char then return nil end
    local humanoid = char:FindFirstChildWhichIsA("Humanoid")
    if humanoid and humanoid.SeatPart and humanoid.SeatPart:IsA("VehicleSeat") then return humanoid.SeatPart end
    return nil
end

local function getAbsoluteBoatBottom(seat)
    local boat = seat.Parent
    local lowestY = seat.Position.Y
    if boat then
        for _, part in pairs(boat:GetDescendants()) do
            if part:IsA("BasePart") and part.Name ~= "RealNeonBottomCarpet" then
                if part.Position.Y < lowestY then lowestY = part.Position.Y end
            end
        end
    end
    return lowestY
end

local function createRealCarpet()
    if RealCarpet then RealCarpet:Destroy() end
    RealCarpet = Instance.new("Part")
    RealCarpet.Name = "RealNeonBottomCarpet"
    RealCarpet.Size = Vector3.new(450, 3, 450) -- Thảm siêu rộng chống hụt góc
    RealCarpet.Transparency = 1
    RealCarpet.Color = Color3.fromRGB(0, 255, 128)
    RealCarpet.Material = Enum.Material.Neon
    RealCarpet.Anchored = true 
    RealCarpet.CanCollide = true
    RealCarpet.CollisionGroup = "GhostCarpetGroup"
    RealCarpet.CustomPhysicalProperties = PhysicalProperties.new(0, 0, 0, 0, 0) -- Không ma sát
    RealCarpet.Parent = workspace
end

local function cleanUpForces()
    if activeVelocity then activeVelocity:Destroy() activeVelocity = nil end
    if activeAttachment then activeAttachment:Destroy() activeAttachment = nil end
    if RealCarpet then RealCarpet:Destroy() RealCarpet = nil end
end

