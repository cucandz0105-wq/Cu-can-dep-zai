local function getDrivenSeat()
    local char = LocalPlayer.Character
    if not char then return nil end
    local humanoid = char:FindFirstChildWhichIsA("Humanoid")
    if humanoid and humanoid.SeatPart and humanoid.SeatPart:IsA("VehicleSeat") then return humanoid.SeatPart end
    return nil
end

local function assignBoatToGroup(seat)
    local boat = seat.Parent
    if boat then
        for _, part in pairs(boat:GetDescendants()) do
            if part:IsA("BasePart") then
                pcall(function()
                    part.CollisionGroup = "PlayerBoatGroup"
                    if part.CustomPhysicalProperties then
                        part.CustomPhysicalProperties = PhysicalProperties.new(part.Material, 0.3, 0, 1, 1)
                    end
                end)
            end
        end
    end
end

local function createGhostCarpet()
    if GhostCarpet then GhostCarpet:Destroy() end
    GhostCarpet = Instance.new("Part")
    GhostCarpet.Name = "SafestUnderCarpet"
    GhostCarpet.Size = Vector3.new(400, 30, 400)
    GhostCarpet.Transparency = 1 
    GhostCarpet.Anchored = true 
    GhostCarpet.CanCollide = true 
    GhostCarpet.CollisionGroup = "GhostCarpetGroup"
    GhostCarpet.Parent = workspace
end

local function removeCarpet()
    if GhostCarpet then GhostCarpet:Destroy() GhostCarpet = nil end
end

local function cleanUpForces()
    if activeVelocity then activeVelocity:Destroy() activeVelocity = nil end
    if activeAttachment then activeAttachment:Destroy() activeAttachment = nil end
end

UpBtn.MouseButton1Click:Connect(function() if _G.BoatFlyActive then _G.ManualOffset = _G.ManualOffset + 3 end end)
DownBtn.MouseButton1Click:Connect(function() if _G.BoatFlyActive then _G.ManualOffset = _G.ManualOffset - 3 end end)

RunService.PreSimulation:Connect(function()
    local seat = getDrivenSeat()
    if seat then
        if seat.ReceiveAge > 0 then settings().Physics.AllowSleep = false end
        assignBoatToGroup(seat)
        if _G.BoatFlyActive then
            if not _G.BaseFloatLevel then _G.BaseFloatLevel = seat.Position.Y - 23 end
            local finalCarpetY = _G.BaseFloatLevel + _G.ManualOffset
            HeightLabel.Text = "Vị trí thảm Y: " .. tostring(math.floor(finalCarpetY))
            if not GhostCarpet then createGhostCarpet() end
            GhostCarpet.Position = Vector3.new(seat.Position.X, finalCarpetY - 14, seat.Position.Z)
            GhostCarpet.Orientation = Vector3.new(0, 0, 0)
        else
            removeCarpet()
            if _G.BaseFloatLevel then HeightLabel.Text = "Độ Cao Thảm: Tắt" _G.BaseFloatLevel = nil end
        end

        if _G.SuperSailActive then
            if not activeAttachment or activeAttachment.Parent ~= seat then
                cleanUpForces()
                activeAttachment = Instance.new("Attachment")
                activeAttachment.Parent = seat
            end
            if not activeVelocity or activeVelocity.Parent ~= seat then
                activeVelocity = Instance.new("LinearVelocity")
                activeVelocity.Attachment0 = activeAttachment
                activeVelocity.MaxForce = math.huge
                activeVelocity.VelocityConstraintMode = Enum.VelocityConstraintMode.Vector
                activeVelocity.Parent = seat
            end
            local forward = seat.CFrame.LookVector
            activeVelocity.VectorVelocity = Vector3.new(forward.X, 0, forward.Z).Unit * _G.BoostMultiplier
        else
            if activeVelocity then activeVelocity:Destroy() activeVelocity = nil end
        end
    else
        cleanUpForces()
        removeCarpet()
        _G.BaseFloatLevel = nil
        HeightLabel.Text = "Độ Cao Thảm: Tắt"
    end
end)

