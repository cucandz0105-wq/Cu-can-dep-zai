local function updateTargets()
    TargetKeywords = {}
    for segment in string.gmatch(TextBox.Text, "([^,]+)") do
        local clean = string.gsub(segment, "^%s*(.-)%s*$", "%1")
        if clean ~= "" then table.insert(TargetKeywords, string.lower(clean)) end
    end
    updateStatusText()
end

