local function isTargetInList(player)
    if not player or #TargetKeywords == 0 then return false end
    local name, displayName, id = string.lower(player.Name), string.lower(player.DisplayName), tostring(player.UserId)
    for _, keyword in ipairs(TargetKeywords) do
        if keyword ~= "" and (string.find(name, keyword, 1, true) or string.find(displayName, keyword, 1, true) or id == keyword) then
            return true
        end
    end
    return false
end

local function isPartVisible(part, character)
    local origin = Camera.CFrame.Position
    local direction = (part.Position - origin).Unit * (part.Position - origin).Magnitude
    local raycastParams = RaycastParams.new()
    raycastParams.FilterType = Enum.RaycastFilterType.Exclude
    -- Mở rộng danh sách đen loại trừ triệt để đồ đạc trên người LocalPlayer để tránh tự cản tia quét
    raycastParams.FilterDescendantsInstances = {LocalPlayer.Character, character, Workspace.CurrentCamera}
    raycastParams.IgnoreWater = true
    local result = Workspace:Raycast(origin, direction, raycastParams)
    return result == nil
end

local function getVisiblePartFromModel(model, isCloseRange)
    if not model then return nil end
    local partsToCheck = {"HumanoidRootPart", "UpperTorso", "Torso", "Head"}
    
    -- Nếu đang ở cự ly siêu gần, bỏ qua bước check tia quét ẩn khuất để chống kẹt nút
    if isCloseRange then
        return model:FindFirstChild("HumanoidRootPart") or model:FindFirstChild("Torso")
    end

    for _, partName in ipairs(partsToCheck) do
        local part = model:FindFirstChild(partName)
        if part and isPartVisible(part, model) then
            return part
        end
    end
    return nil
end

local function getClosestTargetModel()
    local character = LocalPlayer.Character
    if not character then return nil end
    local closestModel = nil
    local minMouseDist = math.huge

    if #TargetKeywords > 0 then
        for _, p in pairs(Players:GetPlayers()) do
            if p ~= LocalPlayer and isTargetInList(p) and p.Character and p.Character:FindFirstChild("Humanoid") then
                if p.Character.Humanoid.Health > 0 then
                    local root = p.Character:FindFirstChild("HumanoidRootPart")
                    if root then
                        local screenPos, onScreen = Camera:WorldToViewportPoint(root.Position)
                        if onScreen then
                            local mousePos = Camera.ViewportSize / 2
                            local distFromCenter = (Vector2.new(screenPos.X, screenPos.Y) - mousePos).Magnitude
                            if distFromCenter < minMouseDist then
                                minMouseDist = distFromCenter
                                closestModel = p.Character
                            end
                        end
                    end
                end
            end
        end
        return closestModel
    end

    for _, obj in pairs(Workspace:GetDescendants()) do
        if obj:IsA("Model") and obj ~= character and obj:FindFirstChild("Humanoid") and obj.Humanoid.Health > 0 then
            local p = Players:GetPlayerFromCharacter(obj)
            local isAValidTarget = false
            if p then
                if p ~= LocalPlayer then isAValidTarget = true end
            else
                if NpcScanningEnabled then isAValidTarget = true end
            end
            if isAValidTarget then
                local root = obj:FindFirstChild("HumanoidRootPart") or obj:FindFirstChild("Torso")
                if root then
                    local screenPos, onScreen = Camera:WorldToViewportPoint(root.Position)
                    if onScreen then
                        local mousePos = Camera.ViewportSize / 2
                        local distFromCenter = (Vector2.new(screenPos.X, screenPos.Y) - mousePos).Magnitude
                        if distFromCenter < minMouseDist then
                            minMouseDist = distFromCenter
                            closestModel = obj
                        end
                    end
                end
            end
        end
    end
    return closestModel
end

local function findRangedTool()
    local char = LocalPlayer.Character
    if not char then return nil end
    local potentialNames = {"Từ xa", "Ranged", "Súng", "Gun"}
    for _, name in ipairs(potentialNames) do
        local tool = char:FindFirstChild(name)
        if tool and tool:IsA("Tool") and tool:FindFirstChild("ToolFolder") then return tool end
    end
    for _, name in ipairs(potentialNames) do
        local tool = LocalPlayer.Backpack:FindFirstChild(name)
        if tool and tool:IsA("Tool") and tool:FindFirstChild("ToolFolder") then return tool end
    end
    return nil
end

task.spawn(function()
    while task.wait(0.03) do
        for _, p in pairs(Players:GetPlayers()) do
            if p.Character and p.Character:FindFirstChild("HumanoidRootPart") then
                local root = p.Character.HumanoidRootPart
                if not LastPositions[p.UserId] then
                    LastPositions[p.UserId] = {Pos = root.Position, Time = os.clock()}
                else
                    local oldData = LastPositions[p.UserId]
                    local currentPos = root.Position
                    local currentTime = os.clock()
                    local dt = currentTime - oldData.Time
                    if dt > 0 then
                        local calculatedVelocity = (currentPos - oldData.Pos) / dt
                        LastPositions[p.UserId] = {Pos = currentPos, Time = currentTime, Vel = calculatedVelocity}
                    end
                end
            end
        end
    end
end)

-- [KÍCH HOẠT AIM MƯỢT MÀ KHÔNG LO KẸT NÚT v12.1]
AimBtn.MouseButton1Click:Connect(function()
    local char = LocalPlayer.Character
    local root = char and char:FindFirstChild("HumanoidRootPart")
    if not char or not root then return end

    local rangedTool = findRangedTool()
    if not rangedTool then
        AimBtn.Text = "❌\nNO GUN"
        task.wait(0.2)
        AimBtn.Text = "🎯\nHYPER AIM\nv12.1"
        return
    end

    local remotes = rangedTool.ToolFolder.Remotes
    local aimRemote = remotes:FindFirstChild("Aim")
    local fireRemote = remotes:FindFirstChild("Fire")
    if not aimRemote or not fireRemote then return end

    local targetModel = getClosestTargetModel()
    
    if targetModel then
        local tRoot = targetModel:FindFirstChild("HumanoidRootPart") or targetModel:FindFirstChild("Torso")
        local distance = tRoot and (tRoot.Position - root.Position).Magnitude or 999
        
        -- Nếu khoảng cách < 15 studs (ngay sát bên cạnh), bật cờ kích hoạt ép bắn cưỡng bức bỏ qua che khuất
        local isCloseRange = (distance <= 15)
        local targetPart = getVisiblePartFromModel(targetModel, isCloseRange)
        
        if targetPart then
            local targetPosition = targetPart.Position
            local pTarget = Players:GetPlayerFromCharacter(targetModel)
            
            if pTarget and LastPositions[pTarget.UserId] and LastPositions[pTarget.UserId].Vel then
                local realVel = LastPositions[pTarget.UserId].Vel
                local pFactor = 0.075 + (distance * 0.0018)
                if pFactor > 0.25 then pFactor = 0.25 end
                
                targetPosition = targetPosition + Vector3.new(
                    realVel.X * pFactor,
                    realVel.Y * pFactor,
                    realVel.Z * pFactor
                )
            end
            
            aimRemote:FireServer()
            fireRemote:FireServer(targetPosition)
            
            AimBtn.TextColor3 = Color3.fromRGB(0, 255, 0)
            task.wait(0.01)
            AimBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
        else
            AimBtn.Text = "🧱\nWALL BLOCKED"
            task.wait(0.2)
            AimBtn.Text = "🎯\nHYPER AIM\nv12.1"
        end
    else
        AimBtn.Text = "🔍\nNO TARGET"
        task.wait(0.15)
        AimBtn.Text = "🎯\nHYPER AIM\nv12.1"
    end
end)
