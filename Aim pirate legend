local TargetKeywords = {}
local function updateStatusText()
    if #TargetKeywords > 0 then
        StatusLabel.Text = "🔒 Đang ép đạn đón đầu mục tiêu chỉ định!"
        StatusLabel.TextColor3 = Color3.fromRGB(255, 50, 50)
    elseif NpcScanningEnabled then
        StatusLabel.Text = "⚡ Quét tự do: Bắn mọi thứ gần tâm"
        StatusLabel.TextColor3 = Color3.fromRGB(0, 255, 100)
    else
        StatusLabel.Text = "👤 Quét tự do: Chỉ nhắm mục tiêu Người"
        StatusLabel.TextColor3 = Color3.fromRGB(100, 200, 255)
    end
end

local function updateTargets()
    TargetKeywords = {}
    local rawText = TextBox.Text
    for segment in string.gmatch(rawText, "([^,]+)") do
        local clean = string.gsub(segment, "^%s*(.-)%s*$", "%1")
        if clean ~= "" then
            table.insert(TargetKeywords, string.lower(clean))
        end
    end
    updateStatusText()
end

TextBox:GetPropertyChangedSignal("Text"):Connect(updateTargets)
ClearBtn.MouseButton1Click:Connect(function()
    TextBox.Text = ""
    updateTargets()
end)

