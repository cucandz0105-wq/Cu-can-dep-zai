-- ==================== CƠ CHẾ LOGIC DỊCH CHUYỂN CẢI TIẾN ====================
local function refreshPosList()
    for _, child in pairs(PosScrollView:GetChildren()) do
        if child:IsA("Frame") then child:Destroy() end
    end
    
    -- THAY ĐỔI 3: Dùng ipairs() duyệt mảng tuần tự từ 1 đến hết để các dòng thẳng hàng từ trên xuống
    for index, data in ipairs(_G.SavedPositions) do
        local itemFrame = Instance.new("Frame")
        itemFrame.Size = UDim2.new(1, -6, 0, 32)
        itemFrame.BackgroundColor3 = Color3.fromRGB(30, 30, 35)
        itemFrame.ZIndex = 4
        itemFrame.LayoutOrder = index -- Ép ô hiển thị đúng vị trí thứ tự được thêm vào
        itemFrame.Parent = PosScrollView
        Instance.new("UICorner", itemFrame).CornerRadius = UDim.new(0, 4)
        
        local nameLabel = Instance.new("TextLabel")
        nameLabel.Size = UDim2.new(1, -95, 1, 0)
        nameLabel.Position = UDim2.new(0, 6, 0, 0)
        nameLabel.BackgroundTransparency = 1
        nameLabel.Text = data.Name
        nameLabel.TextColor3 = Color3.fromRGB(230, 230, 230)
        nameLabel.Font = Enum.Font.SourceSansBold
        nameLabel.TextSize = 12
        nameLabel.TextXAlignment = Enum.TextXAlignment.Left
        nameLabel.ZIndex = 5
        nameLabel.Parent = itemFrame
        
        -- Nút bấm dịch chuyển đến điểm đã lưu
        local tpBtn = Instance.new("TextButton")
        tpBtn.Size = UDim2.new(0, 40, 0, 24)
        tpBtn.Position = UDim2.new(1, -85, 0.5, -12)
        tpBtn.BackgroundColor3 = Color3.fromRGB(40, 140, 80)
        tpBtn.Text = "TP"
        tpBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
        tpBtn.Font = Enum.Font.SourceSansBold
        tpBtn.TextSize = 11
        tpBtn.ZIndex = 5
        tpBtn.Parent = itemFrame
        Instance.new("UICorner", tpBtn).CornerRadius = UDim.new(0, 4)
        
        tpBtn.MouseButton1Click:Connect(function()
            local char = LocalPlayer.Character
            local root = char and (char:FindFirstChild("HumanoidRootPart") or char:FindFirstChild("PrimaryPart"))
            if root then root.CFrame = data.CFrame end
        end)
        
        -- Nút xóa điểm đơn lẻ
        local delBtn = Instance.new("TextButton")
        delBtn.Size = UDim2.new(0, 40, 0, 24)
        delBtn.Position = UDim2.new(1, -42, 0.5, -12)
        delBtn.BackgroundColor3 = Color3.fromRGB(160, 40, 40)
        delBtn.Text = "Xóa"
        delBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
        delBtn.Font = Enum.Font.SourceSansBold
        delBtn.TextSize = 11
        delBtn.ZIndex = 5
        delBtn.Parent = itemFrame
        Instance.new("UICorner", delBtn).CornerRadius = UDim.new(0, 4)
        
        delBtn.MouseButton1Click:Connect(function()
            table.remove(_G.SavedPositions, index) -- Xóa phần tử khỏi mảng một cách an toàn
            refreshPosList()
        end)
    end
    PosScrollView.CanvasSize = UDim2.new(0, 0, 0, UIListLayout.AbsoluteContentSize.Y + 10)
end

-- Lắng nghe sự kiện bấm nút Lưu
SavePosButton.MouseButton1Click:Connect(function()
    local char = LocalPlayer.Character
    local root = char and (char:FindFirstChild("HumanoidRootPart") or char:FindFirstChild("PrimaryPart"))
    if root then
        local text = PosNameInput.Text
        local finalName = (text ~= "") and text or ("Vị trí " .. tostring(math.random(100, 999)))
        
        -- THAY ĐỔI 4: Đẩy dữ liệu vào dưới dạng một Object nằm trong Array để giữ thứ tự từ trên xuống
        table.insert(_G.SavedPositions, {
            Name = finalName,
            CFrame = root.CFrame
        })
        
        PosNameInput.Text = ""
        refreshPosList()
    end
end)

