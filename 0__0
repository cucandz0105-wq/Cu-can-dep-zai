local btnHeadsit, inputHeadsit = createActionWithInput("Headsit", "Tên tắt/ID")
btnHeadsit.MouseButton1Click:Connect(function()
    local target = getTargetPlayer(inputHeadsit.Text)
    if target and target.Character and target.Character:FindFirstChild("Head") then
        local lpChar = LocalPlayer.Character
        local hum = lpChar and lpChar:FindFirstChild("Humanoid")
        local hrp = lpChar and lpChar:FindFirstChild("HumanoidRootPart")
        if hum and hrp then
            hum.Sit = true
            btnHeadsit.Text = "Headsit: " .. string.sub(target.Name, 1, 5)
            btnHeadsit.BackgroundColor3 = Color3.fromRGB(0, 150, 0)
            
            local headsitConn
            headsitConn = RunService.Heartbeat:Connect(function()
                if target.Character and target.Character:FindFirstChild("Head") and hrp and hum then
                    if hum:GetState() == Enum.HumanoidStateType.Jumping or hum.Jump then
                        hum.Sit = false
                        if headsitConn then headsitConn:Disconnect() end
                        return
                    end
                    hum.Sit = true
                    hrp.CFrame = target.Character.Head.CFrame * CFrame.new(0, -0.2, 0.8) 
                    hrp.Velocity = Vector3.new(0, 0, 0)
                else
                    hum.Sit = false
                    if headsitConn then headsitConn:Disconnect() end
                end
            end)
        end
    else
        btnHeadsit.Text = "Không tìm thấy!"
        btnHeadsit.BackgroundColor3 = Color3.fromRGB(150, 0, 0)
    end
    task.wait(1.5)
    btnHeadsit.Text = "Headsit"
    btnHeadsit.BackgroundColor3 = Color3.fromRGB(60, 60, 60)
end)

