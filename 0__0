        flyBg.cframe = Camera.CFrame
        local moveVector = (Controls and Controls:GetMoveVector()) or Vector3.zero
        local moveDir = (Camera.CFrame.RightVector * moveVector.X) - (Camera.CFrame.LookVector * moveVector.Z)
        if moveDir.Magnitude > 0 then moveDir = moveDir.Unit end
        flyBv.velocity = moveDir * ((tonumber(inputFly.Text) or 2) * 25)
    end
end)

-- 2.1. VEHICLE FLY (VFLY)
local btnVFly, inputVFly = createToggleWithInput("VFly: OFF", 2)
local vflyBv, vflyBg
local currentVehicleSeat = nil

btnVFly.MouseButton1Click:Connect(function()
    states.vfly = not states.vfly
    btnVFly.Text = states.vfly and "VFly: ON" or "VFly: OFF"
    btnVFly.BackgroundColor3 = states.vfly and Color3.fromRGB(0, 150, 0) or Color3.fromRGB(60, 60, 60)
    
    -- Nếu tắt VFly, dọn dẹp các lực đẩy
    if not states.vfly then
        if vflyBv then vflyBv:Destroy() end
        if vflyBg then vflyBg:Destroy() end
        currentVehicleSeat = nil
    end
end)

RunService.RenderStepped:Connect(function()
    if states.vfly then
        local char = LocalPlayer.Character
        local hum = char and char:FindFirstChild("Humanoid")
        
        -- Kiểm tra xem người chơi có đang ngồi trên xe (SeatPart) không
        if hum and hum.SeatPart then
            local seat = hum.SeatPart
            
            -- Nếu vừa bước lên xe mới, khởi tạo lại lực (Force)
            if currentVehicleSeat ~= seat then
                if vflyBv then vflyBv:Destroy() end
                if vflyBg then vflyBg:Destroy() end
                
                currentVehicleSeat = seat
                
                vflyBg = Instance.new("BodyGyro", seat)
                vflyBg.P = 9e4
                vflyBg.maxTorque = Vector3.new(9e9, 9e9, 9e9) -- Max lực để xoay xe
                vflyBg.cframe = seat.CFrame
                
                vflyBv = Instance.new("BodyVelocity", seat)
                vflyBv.maxForce = Vector3.new(9e9, 9e9, 9e9) -- Max lực để nâng được xe nặng
                vflyBv.velocity = Vector3.zero
            end
            
            -- Cập nhật hướng bay của xe theo hướng Camera (tương tự Fly thường)
            if vflyBg and vflyBv then
                vflyBg.cframe = Camera.CFrame
                local moveVector = (Controls and Controls:GetMoveVector()) or Vector3.zero
                local moveDir = (Camera.CFrame.RightVector * moveVector.X) - (Camera.CFrame.LookVector * moveVector.Z)
                
                if moveDir.Magnitude > 0 then moveDir = moveDir.Unit end
                
                -- Nhân với 50 thay vì 25 vì xe thường nặng hơn và cần vận tốc lớn hơn
                vflyBv.velocity = moveDir * ((tonumber(inputVFly.Text) or 2) * 50)
            end
        else
            -- Nếu người chơi nhảy khỏi xe trong lúc VFly đang bật thì dọn dẹp lực đẩy ngay lập tức
            if vflyBv then vflyBv:Destroy() vflyBv = nil end
            if vflyBg then vflyBg:Destroy() vflyBg = nil end
            currentVehicleSeat = nil
        end
    end
end)

