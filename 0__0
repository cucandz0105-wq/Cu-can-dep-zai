local btnFly, inputFly = createToggleWithInput("Fly: OFF", 2)
local flyBv, flyBg

btnFly.MouseButton1Click:Connect(function()
    states.fly = not states.fly
    btnFly.Text = states.fly and "Fly: ON" or "Fly: OFF"
