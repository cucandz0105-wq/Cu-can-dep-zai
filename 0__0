local function getTargetPlayer(str)
    if not str or str == "" then return nil end
    str = string.lower(string.match(str, "^%s*(.-)%s*$"))
    for _, p in pairs(Players:GetPlayers()) do
        if p ~= LocalPlayer then
            local name = string.lower(p.Name)
            local display = string.lower(p.DisplayName)
            local id = tostring(p.UserId)
            if string.sub(name, 1, #str) == str or string.sub(display, 1, #str) == str or id == str then
                return p
            end
        end
    end
    return nil
end

