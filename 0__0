local function handleESP(char, p, isActive, isSelf)
    if not char or not char:FindFirstChild("Head") then return end
    local head = char.Head
    if isActive then
        local teamColor = (p.Team == LocalPlayer.Team and Color3.fromRGB(0, 255, 0)) or (p.TeamColor and p.TeamColor.Color or Color3.fromRGB(255, 0, 0))
        if isSelf then teamColor = Color3.fromRGB(255, 0, 255) end 
        local bill = head:FindFirstChild("ESP_Info") or Instance.new("BillboardGui", head)
        if not head:FindFirstChild("ESP_Info") then
            bill.Name = "ESP_Info"
            bill.Size = UDim2.new(0, 150, 0, 50)
            bill.StudsOffset = Vector3.new(0, 2.5, 0)
            bill.AlwaysOnTop = true
            local textLbl = Instance.new("TextLabel", bill)
            textLbl.Size = UDim2.new(1, 0, 1, 0)
            textLbl.BackgroundTransparency = 1
            textLbl.TextStrokeTransparency = 0 
            textLbl.Font = Enum.Font.GothamBold
            textLbl.TextSize = 12
        end
        local hum = char:FindFirstChild("Humanoid")
        local health = hum and math.floor(hum.Health) or 0
        if isSelf then
            bill.TextLabel.Text = string.format("you\nMáu: %d", health)
        else
            local charRoot = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
            local distance = charRoot and math.floor((charRoot.Position - head.Position).Magnitude) or 0
            bill.TextLabel.Text = string.format("%s\nKC: %dm | Máu: %d", p.Name, distance, health)
        end
        bill.TextLabel.TextColor3 = teamColor
        local highlight = char:FindFirstChild("ESP_Highlight") or Instance.new("Highlight", char)
        highlight.Name = "ESP_Highlight"
        highlight.FillColor = teamColor
        highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
    else
        if head:FindFirstChild("ESP_Info") then head.ESP_Info:Destroy() end
        if char:FindFirstChild("ESP_Highlight") then char.ESP_Highlight:Destroy() end
    end
end

RunService.RenderStepped:Connect(function()
    for _, p in pairs(Players:GetPlayers()) do
        if p ~= LocalPlayer then handleESP(p.Character, p, states.esp, false) end
    end
    handleESP(LocalPlayer.Character, LocalPlayer, states.espyou, true)
end)

