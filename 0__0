-- CHỈ DÙNG 1 VÒNG LẶP RENDERSTEPPED DUY NHẤT
RunService.RenderStepped:Connect(function()
    -- Xử lý ánh sáng Fullbright
    if states.fullbright then
        Lighting.Ambient = Color3.fromRGB(255, 255, 255)
        Lighting.OutdoorAmbient = Color3.fromRGB(255, 255, 255)
        Lighting.Brightness = 2
        Lighting.GlobalShadows = false
    else
        Lighting.Ambient = origAmbient
        Lighting.OutdoorAmbient = origOutdoorAmbient
        Lighting.Brightness = origBrightness
        Lighting.GlobalShadows = origGlobalShadows
    end

    -- Xử lý sương mù (NoFog ưu tiên cao nhất, rồi đến Fullbright, không thì về mặc định)
    if states.nofog then
        Lighting.FogEnd = 1000000
        for _, v in pairs(Lighting:GetChildren()) do
            if v:IsA("Atmosphere") then
                v.Density = 0
            end
        end
    elseif states.fullbright then
        Lighting.FogEnd = 100000
    else
        Lighting.FogEnd = origFogEnd
        for _, item in pairs(atmospheres) do
            if item.obj and item.obj.Parent then
                item.obj.Density = item.density
            end
        end
    end
end)

