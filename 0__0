end)

-- Chặn lệnh Kick bằng hookmetamethod (Chỉ khởi tạo 1 lần duy nhất)
if not getgenv().AntiKickHooked then
    getgenv().AntiKickHooked = true
    local oldNamecall
    oldNamecall = hookmetamethod(game, "__namecall", function(self, ...)
        local method = getnamecallmethod()
        -- Bắt và hủy lệnh Kick nếu nút Anti-Kick đang được BẬT
        if getgenv().isAntiKickEnabled and self == LocalPlayer and (method == "Kick" or method == "kick") then
            warn("🛡️ Anti-Kick: Đã chặn một nỗ lực Kick từ game!")
            return nil
        end
        return oldNamecall(self, ...)
    end)
end

