local TeleportService = game:GetService("TeleportService")
local HttpService = game:GetService("HttpService")

local btnRejoin, btnServerHop = createDoubleBtn("Rejoin", "Server Hop")

btnRejoin.MouseButton1Click:Connect(function()
    btnRejoin.Text = "Đang Rejoin..."
    btnRejoin.BackgroundColor3 = Color3.fromRGB(150, 150, 0)
    pcall(function()
        TeleportService:TeleportToPlaceInstance(game.PlaceId, game.JobId, LocalPlayer)
    end)
    task.wait(2)
    btnRejoin.Text = "Rejoin"
    btnRejoin.BackgroundColor3 = Color3.fromRGB(60, 60, 60)
end)

btnServerHop.MouseButton1Click:Connect(function()
    btnServerHop.Text = "Tìm Server..."
    btnServerHop.BackgroundColor3 = Color3.fromRGB(150, 150, 0)
    
    local foundServer = false

    local success, _ = pcall(function()
        local url = "https://games.roblox.com/v1/games/" .. tostring(game.PlaceId) .. "/servers/Public?sortOrder=Desc&limit=100"
        local data
        
        if type(game.HttpGet) == "function" then
            data = HttpService:JSONDecode(game:HttpGet(url))
        elseif request then
            local res = request({Url = url, Method = "GET"})
            data = HttpService:JSONDecode(res.Body)
        end

        if data and data.data then
            for _, server in ipairs(data.data) do
                if server.playing and server.maxPlayers and server.playing < server.maxPlayers and server.id ~= game.JobId then
                    foundServer = true
                    TeleportService:TeleportToPlaceInstance(game.PlaceId, server.id, LocalPlayer)
                    return
                end
            end
        end
    end)

    if success and foundServer then
        btnServerHop.Text = "Đang vào..."
        btnServerHop.BackgroundColor3 = Color3.fromRGB(0, 150, 0)
    else
        btnServerHop.Text = "Không tìm thấy!"
        btnServerHop.BackgroundColor3 = Color3.fromRGB(150, 0, 0)
    end

    task.wait(2)
    btnServerHop.Text = "Server Hop"
    btnServerHop.BackgroundColor3 = Color3.fromRGB(60, 60, 60)
end)
