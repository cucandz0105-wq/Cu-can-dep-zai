-- 15. ACTIONS (SIT & LIE)
-- ==========================================
local btnSit, btnLie = createDoubleBtn("Sit", "Lie (Nằm): OFF")
local isLying = false
local lieJumpConn = nil

local function StandUp()
    local char = LocalPlayer.Character
    if char then
        local hrp = char:FindFirstChild("HumanoidRootPart")
        local hum = char:FindFirstChildWhichIsA("Humanoid")
        
        if hrp and hrp:FindFirstChild("RootJoint") then
            hrp.RootJoint.C0 = CFrame.new(0, 0, 0) * CFrame.Angles(-math.rad(90), 0, math.rad(180))
        end
        if hum then
            hum.PlatformStand = false
        end
    end
    isLying = false
    btnLie.Text = "Lie (Nằm): OFF"
    btnLie.BackgroundColor3 = Color3.fromRGB(60, 60, 60)
end

btnSit.MouseButton1Click:Connect(function()
    local char = LocalPlayer.Character
    local hum = char and char:FindFirstChildWhichIsA("Humanoid")
    if hum then
        if isLying then StandUp() end
        hum.Sit = true
        btnSit.Text = "Đã Ngồi!"
        btnSit.BackgroundColor3 = Color3.fromRGB(0, 150, 0)
        task.wait(1.5)
        btnSit.Text = "Sit"
        btnSit.BackgroundColor3 = Color3.fromRGB(60, 60, 60)
    end
end)

btnLie.MouseButton1Click:Connect(function()
    local char = LocalPlayer.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    local hum = char and char:FindFirstChildWhichIsA("Humanoid")
    
    if not hrp or not hum then return end
    
    if isLying then
        StandUp()
    else
        isLying = true
        hum.PlatformStand = true
        if hrp:FindFirstChild("RootJoint") then
            hrp.RootJoint.C0 = CFrame.new(0, 0, 0) * CFrame.Angles(0, 0, math.rad(180))
        end
        btnLie.Text = "Lie (Nằm): ON"
        btnLie.BackgroundColor3 = Color3.fromRGB(0, 150, 0)
    end
end)

if lieJumpConn then lieJumpConn:Disconnect() end
lieJumpConn = UserInputService.JumpRequest:Connect(function()
    if isLying then
        StandUp()
    end
end)

LocalPlayer.CharacterAdded:Connect(function()
    isLying = false
end)

