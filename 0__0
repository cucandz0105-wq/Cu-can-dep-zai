-- 2. Freecam
local btnFreecam = createBtn("Freecam: OFF")
states.freecam = false
local freecamConn = nil
local freecamInputConn = nil
local freecamPos = Vector3.new()
local freecamYaw = 0
local freecamPitch = 0

local camSensitivity = 0.015 

btnFreecam.MouseButton1Click:Connect(function()
    states.freecam = not states.freecam
    btnFreecam.Text = states.freecam and "Freecam: ON" or "Freecam: OFF"
    btnFreecam.BackgroundColor3 = states.freecam and Color3.fromRGB(0, 150, 0) or Color3.fromRGB(60, 60, 60)
    
    local char = LocalPlayer.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    local humanoid = char and char:FindFirstChild("Humanoid")

    if states.freecam then
        if hrp then hrp.Anchored = true end
        if humanoid then humanoid.PlatformStand = true end
        
        Camera.CameraType = Enum.CameraType.Scriptable
        freecamPos = Camera.CFrame.Position
        
        local rx, ry, rz = Camera.CFrame:ToEulerAnglesYXZ()
        freecamYaw = ry
        freecamPitch = rx

        freecamInputConn = UserInputService.InputChanged:Connect(function(input, gameProcessedEvent)
            if gameProcessedEvent then return end 
            
            if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
                local delta = input.Delta
                freecamYaw = freecamYaw - delta.X * camSensitivity
                freecamPitch = math.clamp(freecamPitch - delta.Y * camSensitivity, -math.rad(85), math.rad(85))
            end
        end)

        freecamConn = RunService.RenderStepped:Connect(function(dt)
            local moveVector = (Controls and Controls:GetMoveVector()) or Vector3.zero
            local rotationCF = CFrame.Angles(0, freecamYaw, 0) * CFrame.Angles(freecamPitch, 0, 0)
            
            local moveDir = (rotationCF.RightVector * moveVector.X) - (rotationCF.LookVector * moveVector.Z)
            freecamPos = freecamPos + (moveDir * (60 * dt))
            
            Camera.CFrame = CFrame.new(freecamPos) * rotationCF
        end)
    else
        if freecamConn then freecamConn:Disconnect() freecamConn = nil end
        if freecamInputConn then freecamInputConn:Disconnect() freecamInputConn = nil end
        
        if hrp then hrp.Anchored = false end
        if humanoid then humanoid.PlatformStand = false end
        
        Camera.CameraType = Enum.CameraType.Custom
        if char and char:FindFirstChild("Humanoid") then
            Camera.CameraSubject = char.Humanoid
        end
    end
end)

