			if tHrp and myHrp then
				myHrp.CFrame = tHrp.CFrame + Vector3.new(0, 3, 0)
			end
		end
	end
end)

local espActive = false
local espObjects = {}

local function createEsp(plr)
	if plr == Players.LocalPlayer then return end
	
	local function addHighlight()
		if not espActive then return end
		local c = plr.Character
		if c then
			local hrp = c:WaitForChild("HumanoidRootPart", 5)
			if hrp and not c:FindFirstChild("PremiumEspHighlight") then
				local color = plr.TeamColor and plr.TeamColor.Color or Color3.fromRGB(255, 255, 255)
				
				local hl = Instance.new("Highlight")
				hl.Name = "PremiumEspHighlight"
				hl.FillTransparency = 0.5
				hl.OutlineTransparency = 0
				hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
				hl.FillColor = color
				hl.OutlineColor = color
				hl.Parent = c
				table.insert(espObjects, hl)
				
				local bb = Instance.new("BillboardGui")
				bb.Name = "PremiumEspTag"
				bb.Adornee = hrp
				bb.Size = UDim2.new(0, 200, 0, 30)
				bb.StudsOffset = Vector3.new(0, 4.5, 0)
				bb.AlwaysOnTop = true
				bb.Parent = c
				table.insert(espObjects, bb)
				
				local tl = Instance.new("TextLabel")
				tl.Size = UDim2.new(1, 0, 1, 0)
				tl.BackgroundTransparency = 1
				tl.Text = plr.DisplayName or plr.Name
				tl.TextColor3 = color
				tl.TextStrokeTransparency = 0
				tl.TextStrokeColor3 = Color3.fromRGB(0, 0, 0)
				tl.Font = Enum.Font.SourceSansBold
				tl.TextSize = 18
				tl.Parent = bb
			end
		end
	end
	
	plr.CharacterAdded:Connect(addHighlight)
	if plr.Character then addHighlight() end
end

EspToggle.MouseButton1Click:Connect(function()
	espActive = not espActive
	if espActive then
		EspToggle.BackgroundColor3 = Color3.fromRGB(0, 150, 0)
		EspToggle.Text = "ESP: ON"
		for _, p in pairs(Players:GetPlayers()) do createEsp(p) end
	else
		EspToggle.BackgroundColor3 = Color3.fromRGB(50, 50, 50)
		EspToggle.Text = "ESP: OFF"
		for _, o in pairs(espObjects) do
			if o and o.Parent then o:Destroy() end
		end
		espObjects = {}
		for _, p in pairs(Players:GetPlayers()) do
			local c = p.Character
			if c then
				local hl = c:FindFirstChild("PremiumEspHighlight")
				local tag = c:FindFirstChild("PremiumEspTag")
				if hl then hl:Destroy() end
				if tag then tag:Destroy() end
			end
		end
	end
end)

