local flActive = false
local flConn = nil
local floatPart = nil
local lockedY = 0

FloatToggle.MouseButton1Click:Connect(function()
	local lp = Players.LocalPlayer
	flActive = not flActive
	
	if flActive then
		FloatToggle.BackgroundColor3 = Color3.fromRGB(0, 150, 0)
		FloatToggle.Text = "Float: ON"
		
		local c = lp.Character
		local hrp = c and c:FindFirstChild("HumanoidRootPart")
		if hrp then
			local offset = tonumber(FloatInput.Text) or 0
			hrp.CFrame = hrp.CFrame + Vector3.new(0, offset, 0)
			
			lockedY = hrp.Position.Y - 3.25
			
			floatPart = Instance.new("Part")
			floatPart.Size = Vector3.new(15, 0.5, 15)
			floatPart.Transparency = 1
			floatPart.Anchored = true
			floatPart.Name = "PremiumIYFloatPart"
			floatPart.Parent = MyWorkspace
			
			flConn = RunService.RenderStepped:Connect(function()
				local char = lp.Character
				local root = char and char:FindFirstChild("HumanoidRootPart")
				local hum = char and char:FindFirstChildWhichIsA("Humanoid")
				
				if root and floatPart then
					if hum and hum.Jump then
						lockedY = root.Position.Y - 3.25
					end
					root.Velocity = Vector3.new(root.Velocity.X, 0, root.Velocity.Z)
					floatPart.CFrame = CFrame.new(root.Position.X, lockedY, root.Position.Z)
				end
			end)
		else
			flActive = false
		end
	else
		FloatToggle.BackgroundColor3 = Color3.fromRGB(50, 50, 50)
		FloatToggle.Text = "Float: OFF"
		if flConn then flConn:Disconnect() flConn = nil end
		if floatPart then floatPart:Destroy() floatPart = nil end
	end
end)

