local function findPlr(str)
	if str == "" then return nil end
	
	local targetId = tonumber(str)
	if targetId then
		for _, v in pairs(Players:GetPlayers()) do
			if v ~= Players.LocalPlayer and v.UserId == targetId then
				return v
			end
		end
	end
	
	local s = string.lower(str)
	for _, v in pairs(Players:GetPlayers()) do
		if v ~= Players.LocalPlayer then
			local nameLower = string.lower(v.Name)
			local dispLower = string.lower(v.DisplayName)
			if string.sub(dispLower, 1, #s) == s or string.sub(nameLower, 1, #s) == s then
				return v
			end
		end
	end
	return nil
end

