local function findPlr(str)
    if str == "" then return nil end
    local targetId = tonumber(str)
    if targetId then
        for _, v in pairs(Players:GetPlayers()) do
            if v ~= Players.LocalPlayer and v.UserId == targetId then return v end
        end
    end
    local s = string.lower(str)
    for _, v in pairs(Players:GetPlayers()) do
        if v ~= Players.LocalPlayer then
            if string.sub(string.lower(v.DisplayName), 1, #s) == s or string.sub(string.lower(v.Name), 1, #s) == s then return v end
        end
    end
    return nil
end

