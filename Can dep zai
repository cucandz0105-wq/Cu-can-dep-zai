local espActive = false
local espStorage = Workspace:FindFirstChild("PremiumESP_Storage") or Instance.new("Folder", Workspace)
espStorage.Name = "PremiumESP_Storage"

local function getTeamColor(plr)
    if plr.Team == LocalPlayer.Team then
        return Color3.fromRGB(0, 255, 100) 
    elseif plr.Team then
        return plr.Team.TeamColor.Color   
    else
        return Color3.fromRGB(255, 255, 255) 
    end
end

local function createEsp(plr)
    if plr == LocalPlayer or not espActive then return end
    local pName = plr.Name
    if espStorage:FindFirstChild(pName) then espStorage[pName]:Destroy() end
    local char = plr.Character
    if not char then return end
    local hrp = char:WaitForChild("HumanoidRootPart", 5)
    local hum = char:WaitForChild("Humanoid", 5)
    if not hrp or not hum or hum.Health <= 0 then return end
    
    local container = Instance.new("Folder", espStorage)
    container.Name = pName
    local hl = Instance.new("Highlight", container)
    hl.Adornee = char
    hl.FillColor = getTeamColor(plr)
    hl.FillTransparency = 0.5
    hl.OutlineColor = Color3.fromRGB(255, 255, 255)
    hl.OutlineTransparency = 0.2
    
    local bb = Instance.new("BillboardGui", container)
    bb.Name = "EspNameTag"
    bb.AlwaysOnTop = true
    bb.Size = UDim2.new(0, 200, 0, 50)
    bb.StudsOffset = Vector3.new(0, 4.5, 0)
    bb.Adornee = hrp
    
    local tl = Instance.new("TextLabel", bb)
    tl.Size = UDim2.new(1, 0, 1, 0)
    tl.BackgroundTransparency = 1
    tl.TextColor3 = hl.FillColor
    tl.TextSize = 18
    tl.Font = Enum.Font.SourceSansBold
    tl.Text = string.format("%s [Tính toán...]", plr.DisplayName)
end

task.spawn(function()
    while true do
        task.wait(0.25)
        if espActive then
            local myChar = LocalPlayer.Character
            local myHrp = myChar and myChar:FindFirstChild("HumanoidRootPart")
            for _, plr in pairs(Players:GetPlayers()) do
                if plr ~= LocalPlayer then
                    local container = espStorage:FindFirstChild(plr.Name)
                    local char = plr.Character
                    if char and char:FindFirstChild("HumanoidRootPart") and char:FindFirstChild("Humanoid") and char.Humanoid.Health > 0 then
                        if container then
                            local bb = container:FindFirstChild("EspNameTag")
                            local tl = bb and bb:FindFirstChildWhichIsA("TextLabel")
                            local hl = container:FindFirstChildWhichIsA("Highlight")
                            local hrp = char.HumanoidRootPart
                            if tl and hrp and hl and myHrp then
                                local dist = math.floor((hrp.Position - myHrp.Position).Magnitude)
                                tl.Text = string.format("%s [%sm]", plr.DisplayName, dist)
                                local correctColor = getTeamColor(plr)
                                if hl.FillColor ~= correctColor then
                                    hl.FillColor = correctColor
                                    tl.TextColor3 = correctColor
                                end
                            end
                        else
                            createEsp(plr)
                        end
                    else
                        if container then container:Destroy() end
                    end
                end
            end
        end
    end
end)

local connections = {}
local function trackPlayer(plr)
    if plr == LocalPlayer then return end
    connections[plr.UserId] = plr.CharacterAdded:Connect(function()
        task.wait(0.5)
        if espActive then createEsp(plr) end
    end)
end

Players.PlayerAdded:Connect(trackPlayer)
for _, p in pairs(Players:GetPlayers()) do trackPlayer(p) end

Players.PlayerRemoving:Connect(function(plr)
    if connections[plr.UserId] then connections[plr.UserId]:Disconnect() connections[plr.UserId] = nil end
    if espStorage:FindFirstChild(plr.Name) then espStorage[plr.Name]:Destroy() end
end)

