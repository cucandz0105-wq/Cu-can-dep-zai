	b.Font = Enum.Font.SourceSansBold
	b.TextSize = 13
	b.Parent = Sidebar
	btns[id] = b
	
	local f = Instance.new("Frame")
	f.Size = UDim2.new(1, 0, 1, 0)
	f.BackgroundTransparency = 1
	f.Visible = false
	f.Parent = Content
	tabs[id] = f
	return f
end

