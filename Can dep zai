local function findPlr(str)
    if str == "" then return nil end
    local s = string.lower(str)
    for _, v in pairs(Players:GetPlayers()) do
        if v ~= Players.LocalPlayer and (string.sub(string.lower(v.DisplayName), 1, #s) == s or string.sub(string.lower(v.Name), 1, #s) == s) then return v end
    end
    return nil
end

TPBtn.MouseButton1Click:Connect(function()
    local target = findPlr(TPInput.Text)
    if target and target.Character then
        local tHrp = target.Character:FindFirstChild("HumanoidRootPart")
        local myHrp = Players.LocalPlayer.Character and Players.LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
        if tHrp and myHrp then myHrp.CFrame = tHrp.CFrame + Vector3.new(0, 3, 0) end
    end
end)

local espActive = false
local espStorage = workspace:FindFirstChild("PremiumESP_Storage") or Instance.new("Folder", workspace)
espStorage.Name = "PremiumESP_Storage"

local function createEsp(plr)
    if plr == Players.LocalPlayer then return end
    local function addHighlight()
        if not espActive or not plr.Character then return end
        local pName = plr.Name
        if espStorage:FindFirstChild(pName) then espStorage[pName]:Destroy() end
        local container = Instance.new("Folder", espStorage)
        container.Name = pName
        local hl = Instance.new("Highlight", container)
        hl.Adornee = plr.Character
        hl.FillColor = (plr.Team ~= Players.LocalPlayer.Team) and Color3.fromRGB(255, 30, 30) or Color3.fromRGB(0, 255, 100)
        hl.FillTransparency = 0.5
        
        local hrp = plr.Character:WaitForChild("HumanoidRootPart", 5)
        if hrp then
            local bb = Instance.new("BillboardGui", container)
            bb.AlwaysOnTop = true
            bb.Size = UDim2.new(0, 200, 0, 50)
            bb.StudsOffset = Vector3.new(0, 4.5, 0)
            bb.Adornee = hrp
            local tl = Instance.new("TextLabel", bb)
            tl.Size = UDim2.new(1, 0, 1, 0)
            tl.BackgroundTransparency = 1
            tl.TextColor3 = hl.FillColor
            tl.TextSize = 22
            tl.Font = Enum.Font.SourceSansBold
            
            task.spawn(function()
                while espActive and plr.Character and hrp and container.Parent do
                    local myChar = Players.LocalPlayer.Character
                    local myHrp = myChar and myChar:FindFirstChild("HumanoidRootPart")
                    tl.Text = myHrp and string.format("%s [%sm]", plr.DisplayName, math.floor((hrp.Position - myHrp.Position).Magnitude)) or plr.DisplayName
                    task.wait(0.2)
                end
            end)
        end
    end
    plr.CharacterAdded:Connect(function() task.wait(0.5); addHighlight() end)
    addHighlight()
end

