-- Hàm phụ để chỉnh font chữ nhanh và tạo viền ô nhập
local function styleLabel(obj, size, isTitle)
    obj.Font = Enum.Font.SourceSansBold
    obj.TextSize = size or 16
    if isTitle then
        obj.TextColor3 = Color3.fromRGB(255, 255, 255) -- Tiêu đề màu trắng sáng hẳn
    else
        obj.TextColor3 = Color3.fromRGB(255, 255, 255)
    end
end

local function styleTextBox(obj)
    obj.Font = Enum.Font.SourceSansBold
    obj.TextSize = 16
    obj.TextColor3 = Color3.fromRGB(255, 255, 0) -- Số nhập hiện màu vàng cho nổi
    obj.BorderSizePixel = 1
    obj.BorderColor3 = Color3.fromRGB(100, 100, 100) -- Có viền xám bao quanh ô nhập
end

