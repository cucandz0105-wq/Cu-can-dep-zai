RunService.RenderStepped:Connect(function()
    if Flying and LocalPlayer.Character then
        local root = LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
        local hum = LocalPlayer.Character:FindFirstChildWhichIsA("Humanoid")
        if root and FlyBV and FlyBG and hum then
            local speed = 25 * (tonumber(FlyInput.Text) or 1)
            local moveDir = hum.MoveDirection
            local forward = CurrentCamera.CFrame.LookVector
            local right = CurrentCamera.CFrame.RightVector
            local flatF = Vector3.new(forward.X, 0, forward.Z).Unit
            local flatR = Vector3.new(right.X, 0, right.Z).Unit
            local finalDir = (forward * moveDir:Dot(flatF)) + (right * moveDir:Dot(flatR))
            if finalDir.Magnitude > 0 then FlyBV.Velocity = finalDir.Unit * speed else FlyBV.Velocity = Vector3.new(0,0,0) end
            if FlyBG then FlyBG.CFrame = CurrentCamera.CFrame end
        end
    end
end)
