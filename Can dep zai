local function createTab(name, id)
    local b = Instance.new("TextButton")
    b.Size = UDim2.new(1, -10, 0, 35)
    b.Position = UDim2.new(0, 5, 0, (#btns * 40) + 5)
    b.BackgroundColor3 = Color3.fromRGB(35, 35, 35)
    b.Text = name
    b.TextColor3 = Color3.fromRGB(255, 255, 255) -- Chữ trên nút Tab màu trắng rõ nét
    b.Font = Enum.Font.SourceSansBold
    b.TextSize = 15
    b.Parent = Sidebar
    btns[id] = b

    local f = Instance.new("ScrollingFrame")
    f.Size = UDim2.new(1, 0, 1, 0)
    f.BackgroundTransparency = 1
    f.CanvasSize = UDim2.new(0, 0, 2.2, 0)
    f.Visible = false
    f.ScrollBarThickness = 4
    f.ScrollBarImageColor3 = Color3.fromRGB(255, 255, 255)
    f.Parent = Content
    tabs[id] = f

    b.MouseButton1Click:Connect(function()
        for i, v in pairs(tabs) do v.Visible = (i == id) end
        for i, v in pairs(btns) do 
            v.BackgroundColor3 = (i == id) and Color3.fromRGB(70, 70, 70) or Color3.fromRGB(35, 35, 35)
            v.TextColor3 = (i == id) and Color3.fromRGB(255, 255, 0) or Color3.fromRGB(255, 255, 255) -- Tab đang chọn đổi sang màu vàng
        end
    end)
end

