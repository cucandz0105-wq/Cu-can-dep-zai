local function createTabButton(name, pos, id)
	local b = Instance.new("TextButton")
	b.Size = UDim2.new(1, -10, 0, 32)
	b.Position = UDim2.new(0, 5, 0, pos)
	b.BackgroundColor3 = Color3.fromRGB(30, 30, 30)
	b.Text = name
