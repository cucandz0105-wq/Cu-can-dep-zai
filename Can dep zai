local viewConn = nil

local function resetCamera()
	if viewConn then viewConn:Disconnect() viewConn = nil end
	local lp = Players.LocalPlayer
	local myC = lp.Character
	local myHum = myC and myC:FindFirstChildWhichIsA("Humanoid")
	if myHum then
		CurrentCamera.CameraSubject = myHum
	end
	ViewStatusLabel.Visible = false
	ViewStatusLabel.Text = ""
end

ViewBtn.MouseButton1Click:Connect(function()
	local txt = ViewInput.Text
	if txt ~= "" then
		local target = findPlr(txt)
		if target and target.Character then
			local tHum = target.Character:FindFirstChildWhichIsA("Humanoid")
			if tHum then
				if viewConn then viewConn:Disconnect() end
				
				CurrentCamera.CameraSubject = tHum
				ViewStatusLabel.Text = "Viewing: " .. target.DisplayName .. " (@" .. target.Name .. ") [ID: " .. tostring(target.UserId) .. "]"
				ViewStatusLabel.Visible = true
				
				viewConn = target.CharacterAdded:Connect(function(newChar)
					local newHum = newChar:WaitForChild("Humanoid", 5)
					if newHum then
						CurrentCamera.CameraSubject = newHum
					else
						resetCamera()
					end
				end)
			end
		end
	end
end)

