local function findPlr(str)
    if str == "" then return nil end
    local s = string.lower(str)
    for _, v in pairs(Players:GetPlayers()) do
        if v ~= LocalPlayer and (string.sub(string.lower(v.DisplayName), 1, #s) == s or string.sub(string.lower(v.Name), 1, #s) == s) then return v end
    end
    return nil
end

