local function cleanUpFloat()
    if renderConnection then renderConnection:Disconnect() renderConnection = nil end
    if platform then platform:Destroy() platform = nil end
end

FloatToggle.MouseButton1Click:Connect(function()
    if not LocalPlayer.Character then return end
    local root = LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
    local hum = LocalPlayer.Character:FindFirstChildWhichIsA("Humanoid")
    if not root or not hum then return end
    
    Floating = not Floating
    FloatToggle.Text = Floating and "Float: ON" or "Float: OFF"
    FloatToggle.BackgroundColor3 = Floating and Color3.fromRGB(0, 170, 0) or Color3.fromRGB(55, 55, 55)
    
    if type(resetCharacterAnimation) == "function" then resetCharacterAnimation() end
    
    if Floating then
        platform = Instance.new("Part")
        platform.Name = "IY_InvisiblePlatform"
        platform.Size = Vector3.new(20, 0.5, 20)
        platform.Transparency = 1 
        platform.Anchored = true
        platform.CanCollide = true
        platform.Material = Enum.Material.Plastic
        platform.Parent = Workspace
        
        local targetY = root.Position.Y - 3.3
        platform.Position = Vector3.new(root.Position.X, targetY, root.Position.Z)
        
        renderConnection = RunService.Heartbeat:Connect(function()
            local currentCharacter = LocalPlayer.Character
            local currentRoot = currentCharacter and currentCharacter:FindFirstChild("HumanoidRootPart")
            local currentHumanoid = currentCharacter and currentCharacter:FindFirstChildWhichIsA("Humanoid")
            if not currentRoot or not currentHumanoid or not platform then return end
            
            local state = currentHumanoid:GetState()
            if state == Enum.HumanoidStateType.Jumping or state == Enum.HumanoidStateType.Freefall or currentHumanoid.Jump then
                targetY = currentRoot.Position.Y - 3.3
            end
            
            platform.Position = Vector3.new(currentRoot.Position.X, targetY, currentRoot.Position.Z)
        end)
    else
        cleanUpFloat()
        hum.FloorMaterial = Enum.Material.Air
    end
end)

