        for i, v in pairs(tabs) do v.Visible = (i == id) end
        for i, v in pairs(btns) do v.BackgroundColor3 = (i == id) and Color3.fromRGB(60, 60, 60) or Color3.fromRGB(30, 30, 30) end
    end)
end

