ButtonCorner.Parent = SlideButton

local isLocked = false
local isDragging = false

-- Hàm kéo thả nút di động
local function makeDraggable(frame)
    local UserInputService = game:GetService("UserInputService")
    local dragInput, dragStart, startPos
    frame.InputBegan:Connect(function(input)
        if (input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch) then
            if isLocked then return end
            isDragging = true
            dragStart = input.Position
            startPos = frame.Position
            input.Changed:Connect(function()
                if input.UserInputState == Enum.UserInputState.End then isDragging = false end
            end)
        end
    end)
    frame.InputChanged:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then dragInput = input end
    end)
    UserInputService.InputChanged:Connect(function(input)
        if input == dragInput and isDragging and not isLocked then
            local delta = input.Position - dragStart
            frame.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
        end
    end)
end
makeDraggable(SlideButton)

-- Cơ chế nhấn giữ khóa vị trí
local holdTime = 1
local holding = false
local holdTimer = 0
local holdCoroutine = nil

SlideButton.MouseButton1Down:Connect(function()
    if isDragging then return end
    holding = true
    holdTimer = 0
    if holdCoroutine then task.cancel(holdCoroutine) end
    holdCoroutine = task.spawn(function()
        local currentTimer = 0
        while holding do
            task.wait(0.1)
            if not holding then break end
            currentTimer = currentTimer + 0.1
            holdTimer = currentTimer
            if currentTimer >= holdTime then
                isLocked = not isLocked
                SlideButton.BackgroundColor3 = isLocked and Color3.fromRGB(60, 255, 60) or Color3.fromRGB(255, 60, 60)
                holding = false
                break
            end
        end
    end)
end)

local function cancelHold()
    holding = false
    if holdCoroutine then task.cancel(holdCoroutine); holdCoroutine = nil end
end
SlideButton.MouseButton1Up:Connect(cancelHold)
SlideButton.MouseLeave:Connect(cancelHold)

