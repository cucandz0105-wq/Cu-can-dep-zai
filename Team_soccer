-- LOGIC XOẠC: TANK-DASH (OFFSET 7 STUDS + NÂNG CAO 3 STUDS)
----------------------------------------------------
local isCooldown = false

SlideButton.MouseButton1Click:Connect(function()
    if holdTimer >= holdTime then holdTimer = 0 return end
    if isCooldown then return end

    local ball = workspace:FindFirstChild("BallsInPlay") and workspace:FindFirstChild("BallsInPlay"):FindFirstChild("Ball")
    local player = game.Players.LocalPlayer
    local char = player.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    local hum = char and char:FindFirstChildOfClass("Humanoid")
    
    if ball and hrp then
        local distance = (hrp.Position - ball.Position).Magnitude
        
        if distance <= 30 then
            isCooldown = true
            local anchorPosition = ball.Position
            
            -- TÍNH TOÁN HƯỚNG DI CHUYỂN THỰC TẾ CỦA BÓNG
            local ballMoveDir = ball.AssemblyLinearVelocity
            local direction = (ballMoveDir.Magnitude > 1) and ballMoveDir.Unit or hrp.CFrame.LookVector
            direction = Vector3.new(direction.X, 0, direction.Z).Unit
            
            -- Điểm dừng cách tâm bóng 7 studs và LUÔN CAO HƠN TÂM BÓNG 3 STUDS ĐỂ KHÔNG BỊ LÚN ĐẤT
            local targetPos = ball.Position + (direction * 7)
            targetPos = Vector3.new(targetPos.X, ball.Position.Y + 3, targetPos.Z)
            
            -- ĐỔI HƯỚNG NHÂN VẬT: Quay mặt cùng chiều với hướng bóng lăn
            hrp.CFrame = CFrame.new(hrp.Position, hrp.Position + direction)
            
            -- BƯỚC 1: LƯỚT ĐẾN ĐÚNG ĐIỂM ĐÃ ĐƯỢC NÂNG CAO BẰNG BODYVELOCITY
            local bodyVel = Instance.new("BodyVelocity")
            bodyVel.MaxForce = Vector3.new(100000, 100000, 100000) -- Bật lực kháng trọng lực nhẹ theo trục Y
            bodyVel.Velocity = (targetPos - hrp.Position).Unit * 150
            bodyVel.Parent = hrp
            
            local dashTime = tick()
            while tick() - dashTime < 0.3 do
                if (ball.Position - anchorPosition).Magnitude > 30 then break end
                task.wait(0.05)
            end
            
            -- Xóa lực đẩy sau khi lướt xong
            bodyVel:Destroy()
            
            -- BƯỚC 2: KÍCH HOẠT LỆNH XOẠC (FIRE SERVER)
            game:GetService("ReplicatedStorage"):WaitForChild("Events"):WaitForChild("Slide"):FireServer(ball, 0.5, false)
            
            -- BƯỚC 3: KHÓA CHÂN/THÂN (LOCK-ON DÍNH VÀO NGƯỜI - HRP)
            local att0 = Instance.new("Attachment", hrp)
            local att1 = Instance.new("Attachment", ball)
            local alignPos = Instance.new("AlignPosition", hrp)
            alignPos.Attachment0 = att0
            alignPos.Attachment1 = att1
            alignPos.MaxForce = 999999 
            alignPos.Responsiveness = 100
            
            -- Duy trì ghim bám trong 0.7s
            local lockTime = tick()
            while tick() - lockTime < 0.7 do
                if (ball.Position - anchorPosition).Magnitude > 30 then break end
                task.wait(0.05)
            end
            
            -- DỌN DẸP AN TOÀN
            att0:Destroy()
            att1:Destroy()
            alignPos:Destroy()
            
            if hrp then hrp.AssemblyLinearVelocity = Vector3.new(0, 0, 0) end
            if hum then hum:ChangeState(Enum.HumanoidStateType.Running) end
            
            task.wait(0.3) 
            isCooldown = false
        else
            -- Xoạc thường nếu ngoài tầm 30 studs
            isCooldown = true
            game:GetService("ReplicatedStorage"):WaitForChild("Events"):WaitForChild("Slide"):FireServer(ball, 0.5, false)
            task.wait(0.5)
            isCooldown = false
        end
    end
end)
