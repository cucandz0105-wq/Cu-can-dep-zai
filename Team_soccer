-- CƠ CHẾ NHẤN GIỮ ĐỂ KHÓA / MỞ KHÓA VỊ TRÍ (GIỮ 1 GIÂY) - ĐÃ FIX CHUẨN
----------------------------------------------------
local holdTime = 1
local holding = false
local holdTimer = 0
local holdCoroutine = nil

SlideButton.MouseButton1Down:Connect(function()
    if isDragging then return end
    
    holding = true
    holdTimer = 0
    
    if holdCoroutine then
        task.cancel(holdCoroutine)
    end
    
    holdCoroutine = task.spawn(function()
        local currentTimer = 0
        while holding do
            task.wait(0.1)
            if not holding then break end
            
            currentTimer = currentTimer + 0.1
            holdTimer = currentTimer
            
            if currentTimer >= holdTime then
                isLocked = not isLocked
                if isLocked then
                    SlideButton.BackgroundColor3 = Color3.fromRGB(60, 255, 60) -- Xanh lá: Khóa vị trí
                else
                    SlideButton.BackgroundColor3 = Color3.fromRGB(255, 60, 60) -- Đỏ: Mở khóa di chuyển
                end
                
                holding = false
                break
            end
        end
    end)
end)

local function cancelHold()
    holding = false
    if holdCoroutine then
        task.cancel(holdCoroutine)
        holdCoroutine = nil
    end
end

SlideButton.MouseButton1Up:Connect(cancelHold)
SlideButton.MouseLeave:Connect(cancelHold)

