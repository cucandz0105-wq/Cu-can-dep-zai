-- LOGIC XOẠC AN TOÀN TUYỆT ĐỐI (COOLDOWN >= 0.5S)
----------------------------------------------------
local isCooldown = false -- Biến trạng thái chờ

SlideButton.MouseButton1Click:Connect(function()
    -- Nếu đang trong thời gian hồi chiêu của cú xoạc trước thì chặn luôn
    if isCooldown then return end

    local ballsInPlay = workspace:FindFirstChild("BallsInPlay")
    local ball = ballsInPlay and ballsInPlay:FindFirstChild("Ball")
    
    local player = game.Players.LocalPlayer
    local character = player.Character
    local humanoid = character and character:FindFirstChildOfClass("Humanoid")
    local hrp = character and character:FindFirstChild("HumanoidRootPart")
    
    if ball then
        isCooldown = true -- Bắt đầu kích hoạt trạng thái chờ
        
        -- 1. Gửi lệnh xoạc lên server
        local args = {ball, 0.5, false}
        game:GetService("ReplicatedStorage"):WaitForChild("Events"):WaitForChild("Slide"):FireServer(unpack(args))
        
        -- 2. Đợi 0.15 giây cho hành động xoạc bắt đầu mượt mà
        task.wait(0.15)
        
        -- 3. Ép Client reset trạng thái vật lý để sửa dáng chạy
        if humanoid and hrp then
            hrp.Velocity = Vector3.new(0, 0, 0)
            humanoid:ChangeState(Enum.HumanoidStateType.Running)
            hrp.CFrame = hrp.CFrame + Vector3.new(0, 0.1, 0)
        end
        
        -- 4. Bù nốt thời gian chờ còn lại để tổng thời gian hồi chiêu đúng bằng 0.5 giây
        task.wait(0.35) 
        
        isCooldown = false -- Mở khóa cho cú bấm tiếp theo
    end
end)

