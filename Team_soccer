-- LOGIC XOẠC AN TOÀN TUYỆT ĐỐI (COOLDOWN >= 0.5S)
----------------------------------------------------
local isCooldown = false

SlideButton.MouseButton1Click:Connect(function()
    -- Nếu vừa thực hiện thao tác giữ để khóa/mở thì bỏ qua sự kiện click xoạc này
    if holdTimer >= holdTime then 
        holdTimer = 0
        return 
    end

    if isCooldown then return end

    local ballsInPlay = workspace:FindFirstChild("BallsInPlay")
    local ball = ballsInPlay and ballsInPlay:FindFirstChild("Ball")
    
    local player = game.Players.LocalPlayer
    local character = player.Character
    local humanoid = character and character:FindFirstChildOfClass("Humanoid")
    local hrp = character and character:FindFirstChild("HumanoidRootPart")
    
    if ball then
        isCooldown = true
        
        local args = {ball, 0.5, false}
        game:GetService("ReplicatedStorage"):WaitForChild("Events"):WaitForChild("Slide"):FireServer(unpack(args))
        
        task.wait(0.15)
        
        if humanoid and hrp then
            hrp.Velocity = Vector3.new(0, 0, 0)
            humanoid:ChangeState(Enum.HumanoidStateType.Running)
            hrp.CFrame = hrp.CFrame + Vector3.new(0, 0.1, 0)
        end
        
        task.wait(0.35) 
        isCooldown = false
    end
end)

