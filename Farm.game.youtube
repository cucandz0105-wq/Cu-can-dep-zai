-- --- LOGIC HOẠT ĐỘNG (LOOPS) ---

local function startUploadLoop()
    task.spawn(function()
        while isAutoUpload do
            pcall(function() uploadAllRemote:FireServer() end)
            task.wait(2)
        end
    end)
end

local function startClaimLoop()
    task.spawn(function()
        while isAutoClaim do
            pcall(function() claimAllRemote:FireServer() end)
            task.wait(2)
        end
    end)
end

local function startCollectLoop()
    task.spawn(function()
        while isAutoCollect do
            local function quetDoiTuong(obj)
                if not isAutoCollect then return end
                local id = string.match(obj.Name, "%w+-%w+-%w+-%w+-%w+")
                if id then
                    pcall(function() 
                        local args = { id }
                        collectRemote:FireServer(unpack(args)) 
                    end)
                    task.wait(0.02)
                end
                for _, child in pairs(obj:GetChildren()) do quetDoiTuong(child) end
            end
            quetDoiTuong(workspace)
            local backpack = localPlayer:FindFirstChild("Backpack")
            if backpack then quetDoiTuong(backpack) end
            task.wait(0.5)
        end
    end)
end

local function startRebirthLoop()
    task.spawn(function()
        while isAutoRebirth do
            pcall(function() 
                local args = { 5 }
                rebirthRemote:FireServer(unpack(args)) 
            end)
            task.wait(3)
        end
    end)
end


-- --- SỰ KIỆN CÁC NÚT BẤM ---

uploadButton.MouseButton1Click:Connect(function()
    isAutoUpload = not isAutoUpload
    uploadButton.Text = isAutoUpload and "Auto Upload: ON" or "Auto Upload: OFF"
    uploadButton.BackgroundColor3 = isAutoUpload and Color3.fromRGB(60, 220, 60) or Color3.fromRGB(255, 60, 60)
    if isAutoUpload then startUploadLoop() end
end)

claimButton.MouseButton1Click:Connect(function()
    isAutoClaim = not isAutoClaim
    claimButton.Text = isAutoClaim and "Auto Claim: ON" or "Auto Claim: OFF"
    claimButton.BackgroundColor3 = isAutoClaim and Color3.fromRGB(60, 220, 60) or Color3.fromRGB(255, 60, 60)
    if isAutoClaim then startClaimLoop() end
end)

collectButton.MouseButton1Click:Connect(function()
    isAutoCollect = not isAutoCollect
    collectButton.Text = isAutoCollect and "Auto Collect: ON" or "Auto Collect: OFF"
    collectButton.BackgroundColor3 = isAutoCollect and Color3.fromRGB(60, 220, 60) or Color3.fromRGB(255, 60, 60)
    if isAutoCollect then startCollectLoop() end
end)

rebirthButton.MouseButton1Click:Connect(function()
    isAutoRebirth = not isAutoRebirth
    rebirthButton.Text = isAutoRebirth and "Auto Rebirth: ON" or "Auto Rebirth: OFF"
    rebirthButton.BackgroundColor3 = isAutoRebirth and Color3.fromRGB(60, 220, 60) or Color3.fromRGB(255, 60, 60)
    if isAutoRebirth then startRebirthLoop() end
end)


-- --- [MỚI] CƠ CHẾ ĐÓNG / MỞ SONG SONG TÁCH BIỆT ---

-- Bấm nút X: Ẩn menu chính đi (Nút tròn M vẫn nằm im ở góc của nó không đổi)
closeButton.MouseButton1Click:Connect(function()
    mainPanel.Visible = false
end)

-- Bấm nút M tròn: Đóng/Mở (Toggle) menu chính tại chỗ của nó, còn nút M không bao giờ biến mất!
openRoundButton.MouseButton1Click:Connect(function()
    mainPanel.Visible = not mainPanel.Visible
end)
