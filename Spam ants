local function updateTickVisual(button, state, labelText)
	if state then
		button.Text = "✅ " .. labelText
		button.TextColor3 = Color3.fromRGB(255, 255, 255)
		TweenService:Create(button, TweenInfo.new(0.2), {BackgroundColor3 = Color3.fromRGB(34, 139, 34)}):Play() 
	else
		button.Text = "❌ " .. labelText
		button.TextColor3 = Color3.fromRGB(200, 200, 200)
		TweenService:Create(button, TweenInfo.new(0.2), {BackgroundColor3 = Color3.fromRGB(45, 45, 45)}):Play() 
	end
end

