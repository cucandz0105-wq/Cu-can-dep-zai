-- LOGIC CRATE ESP
local function clearAllCrateESP()
    for obj, espItems in pairs(_G.ActiveESP) do
        for _, item in pairs(espItems) do if item then item:Destroy() end end
    end
    table.clear(_G.ActiveESP)
end

local function isInShopOrLobby(object)
    local current = object.Parent
    while current and current ~= Workspace do
        local name = string.lower(current.Name)
        if string.find(name, "shop") or string.find(name, "lobby") or string.find(name, "safezone") then return true end
        current = current.Parent
    end
    return false
end

local function createCrateESP(part)
    if not part:IsA("BasePart") or _G.ActiveESP[part] then return end
    local espItems = {}
    local highlight = Instance.new("Highlight")
    highlight.FillColor = Color3.fromRGB(255, 100, 0)
    highlight.FillTransparency = 0.4
    highlight.OutlineColor = Color3.fromRGB(255, 255, 255)
    highlight.OutlineTransparency = 0.2
    highlight.Adornee = part
    highlight.Parent = UI.ScreenGui
    table.insert(espItems, highlight)
    
    local billboard = Instance.new("BillboardGui")
    billboard.Size = UDim2.new(0, 120, 0, 40)
    billboard.AlwaysOnTop = true
    billboard.ExtentsOffset = Vector3.new(0, 3, 0)
    billboard.Adornee = part
    billboard.Parent = UI.ScreenGui
    table.insert(espItems, billboard)
    
    local label = Instance.new("TextLabel")
    label.Size = UDim2.new(1, 0, 1, 0)
    label.BackgroundTransparency = 1
    label.TextColor3 = Color3.fromRGB(255, 230, 0) 
    label.Font = Enum.Font.SourceSansBold
    label.TextSize = 13
    label.Parent = billboard
    table.insert(espItems, label)
    _G.ActiveESP[part] = espItems
    
    task.spawn(function()
        while part and part.Parent and RocketConfig.ESPEnabled and _G.ActiveESP[part] do
            if part.Transparency >= 1 or part.CanCollide == false then break end
            if LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart") then
                local myPos = LocalPlayer.Character.HumanoidRootPart.Position
                local dist = math.floor((part.Position - myPos).Magnitude)
                label.Text = string.format("%s\n[%dm]", part.Name, dist)
            end
            task.wait(0.3)
        end
        if _G.ActiveESP[part] then
            for _, item in pairs(_G.ActiveESP[part]) do if item then item:Destroy() end end
            _G.ActiveESP[part] = nil
        end
    end)
end

UI.ESPButton.MouseButton1Click:Connect(function()
    RocketConfig.ESPEnabled = not RocketConfig.ESPEnabled
    UI.ESPButton.Text = RocketConfig.ESPEnabled and "Crate: ON" or "Crate ESP: OFF"
    UI.ESPButton.BackgroundColor3 = RocketConfig.ESPEnabled and Color3.fromRGB(50, 180, 100) or Color3.fromRGB(180, 50, 50)
    if not RocketConfig.ESPEnabled then clearAllCrateESP() end
end)

task.spawn(function()
    while true do
        if RocketConfig.ESPEnabled then
            local character = LocalPlayer.Character
            for _, obj in pairs(Workspace:GetDescendants()) do
                if obj:IsA("BasePart") and (not character or not obj:IsDescendantOf(character)) then
                    if string.find(string.lower(obj.Name), "crate") then
                        if obj.Transparency < 1 and obj.CanCollide == true and not isInShopOrLobby(obj) then createCrateESP(obj) end
                    end
                end
            end
            for part, espItems in pairs(_G.ActiveESP) do
                if not part or not part.Parent or part.Transparency >= 1 or part.CanCollide == false or isInShopOrLobby(part) then
                    for _, item in pairs(espItems) do if item then item:Destroy() end end
                    _G.ActiveESP[part] = nil
                end
            end
        end
        task.wait(1.0)
    end
end)

