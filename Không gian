local function clearAllOrbESP()
    for obj, espItems in pairs(_G.OrbObjectsESP) do
        for _, item in pairs(espItems) do if item then item:Destroy() end end
    end
    table.clear(_G.OrbObjectsESP)
end

local function isValidOrb(object)
    local current = object
    while current and current ~= Workspace do
        local nameLower = string.lower(current.Name)
        -- THAY ĐỔI: Lọc bỏ thêm tất cả các dạng từ khoá "hole" để chặn đứng Hole Orb
        if string.find(nameLower, "rocket") or string.find(nameLower, "spawn") or
           string.find(nameLower, "fake") or string.find(nameLower, "shop") or
           string.find(nameLower, "lobby") or string.find(nameLower, "hole") then 
            return false 
        end
        current = current.Parent
    end
    return true
end

local function createOrbESP(part)
    if not part or not part:IsA("BasePart") or _G.OrbObjectsESP[part] then return end
    local espItems = {}
    
    local highlight = Instance.new("Highlight")
    highlight.FillColor = Color3.fromRGB(0, 100, 255)
    highlight.FillTransparency = 0.4
    highlight.OutlineColor = Color3.fromRGB(255, 255, 255)
    highlight.OutlineTransparency = 0.1
    highlight.Adornee = part
    highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
    highlight.Parent = UI.ScreenGui
    table.insert(espItems, highlight)
    
    local billboard = Instance.new("BillboardGui")
    billboard.Size = UDim2.new(0, 120, 0, 40)
    billboard.AlwaysOnTop = true
    billboard.MaxDistance = math.huge
    billboard.ExtentsOffset = Vector3.new(0, 3, 0)
    billboard.Adornee = part
    billboard.Parent = UI.ScreenGui
    table.insert(espItems, billboard)
    
    local label = Instance.new("TextLabel")
    label.Size = UDim2.new(1, 0, 1, 0)
    label.BackgroundTransparency = 1
    label.TextColor3 = Color3.fromRGB(100, 200, 255)
    label.Font = Enum.Font.SourceSansBold
    label.TextSize = 13
    label.Parent = billboard
    table.insert(espItems, label)
    
    _G.OrbObjectsESP[part] = espItems
    
    task.spawn(function()
        while part and part.Parent and RocketConfig.OrbESPActive and _G.OrbObjectsESP[part] do
            if part.Transparency >= 1 then break end
            if LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart") then
                local myPos = LocalPlayer.Character.HumanoidRootPart.Position
                local dist = math.floor((part.Position - myPos).Magnitude)
                label.Text = string.format("%s\n[%dm]", part.Name, dist)
            end
            task.wait(0.2)
        end
        if _G.OrbObjectsESP[part] then
            for _, item in pairs(_G.OrbObjectsESP[part]) do if item then item:Destroy() end end
            _G.OrbObjectsESP[part] = nil
        end
    end)
end

local function forceProcessOrb(obj)
    if not RocketConfig.OrbESPActive then return end
    if string.find(string.lower(obj.Name), "orb") then
        local targetPart = obj:IsA("Model") and (obj.PrimaryPart or obj:FindFirstChildWhichIsA("BasePart")) or obj
        if targetPart and targetPart:IsA("BasePart") and isValidOrb(targetPart) then createOrbESP(targetPart) end
    end
end

UI.OrbESPButton.MouseButton1Click:Connect(function()
    RocketConfig.OrbESPActive = not RocketConfig.OrbESPActive
    UI.OrbESPButton.Text = RocketConfig.OrbESPActive and "Orb: ON" or "Orb ESP: OFF"
    UI.OrbESPButton.BackgroundColor3 = RocketConfig.OrbESPActive and Color3.fromRGB(50, 180, 100) or Color3.fromRGB(180, 50, 50)
    if not RocketConfig.OrbESPActive then clearAllOrbESP() end
end)

task.spawn(function()
    while true do
        if RocketConfig.OrbESPActive then
            pcall(function()
                local allData = Workspace:GetDescendants()
                for i = 1, #allData do
                    local obj = allData[i]
                    if obj and string.find(string.lower(obj.Name), "orb") then forceProcessOrb(obj) end
                end
            end)
            pcall(function()
                for _, tag in pairs(CollectionService:GetTags()) do
                    if string.find(string.lower(tag), "orb") then
                        for _, obj in pairs(CollectionService:GetTagged(tag)) do forceProcessOrb(obj) end
                    end
                end
            end)
            for part, espItems in pairs(_G.OrbObjectsESP) do
                if not part or not part.Parent or part.Transparency >= 1 or not part:IsDescendantOf(Workspace) then
                    for _, item in pairs(espItems) do if item then item:Destroy() end end
                    _G.OrbObjectsESP[part] = nil
                end
            end
        end
        task.wait(0.3)
    end
end)

