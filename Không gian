-- Smart Vacuum (Hút đá)
local function getMineralsDistance(part)
    if LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart") then
        return (LocalPlayer.Character.HumanoidRootPart.Position - part.Position).Magnitude
    end
    return 99999
end

UI.FlashButton.MouseButton1Click:Connect(function()
    RocketConfig.VacuumEnabled = not RocketConfig.VacuumEnabled
    UI.FlashButton.Text = RocketConfig.VacuumEnabled and "Smart Vacuum: ON" or "Smart Vacuum (Dig): OFF"
    UI.FlashButton.BackgroundColor3 = RocketConfig.VacuumEnabled and Color3.fromRGB(50, 180, 100) or Color3.fromRGB(180, 50, 50)
    
    if RocketConfig.VacuumEnabled then
        task.spawn(function()
            local CommonLocalEvent = ReplicatedStorage:WaitForChild("Events", 10):WaitForChild("CommonLocalEvent", 10)
            while RocketConfig.VacuumEnabled do
                if CommonLocalEvent then
                    local count = 0
                    for _, folder in ipairs(Workspace:GetDescendants()) do
                        if not RocketConfig.VacuumEnabled then break end
                        if count >= 3 then break end
                        if folder:IsA("Folder") and folder.Name == "Minerals" then
                            for _, rock in ipairs(folder:GetChildren()) do
                                if count >= 3 then break end
                                if rock:IsA("BasePart") or rock:IsA("Model") then
                                    local targetPart = rock:IsA("Model") and (rock.PrimaryPart or rock:FindFirstChildWhichIsA("BasePart")) or rock
                                    if targetPart and getMineralsDistance(targetPart) < 25 then
                                        CommonLocalEvent:FireServer("mineral", { part = rock })
                                        count = count + 1
                                        task.wait(0.08)
                                    end
                                end
                            end
                        end
                    end
                end
                task.wait(0.5)
            end
        end)
    end
end)

