local function GetNearestPInsideDomain(domainCenter, range)
    local t, dist = nil, range
    for _, p in ipairs(P:GetPlayers()) do
        if p ~= LP and p.Character then
            local hrp, hum = p.Character:FindFirstChild("HumanoidRootPart"), p.Character:FindFirstChild("Humanoid")
            if hrp and hum and hum.Health > 0 then
                local distToCenter = (hrp.Position - domainCenter).Magnitude
                if distToCenter <= range then
                    local d = (LP.Character.HumanoidRootPart.Position - hrp.Position).Magnitude
                    if d <= dist then dist, t = d, hrp end
                end
            end
        end
    end
    return t
end

local function CreateDomain(tPos)
    folder = Instance.new("Folder", workspace)
    folder.Name = "FlorentinoFlowers"
    centerPos = tPos
    
    local domainSphere = Instance.new("Part", folder)
    domainSphere.Name = "PurpleFlower"
    domainSphere.Shape = Enum.PartType.Ball
    domainSphere.Size = Vector3.new(2, 2, 2)
    domainSphere.Position = tPos + Vector3.new(0, 2, 0)
    domainSphere.Material = Enum.Material.Glass
    domainSphere.Color = Color3.fromRGB(180, 50, 255)
    domainSphere.Transparency = 0.88
    domainSphere.Anchored = true
    domainSphere.CanCollide = false

    local l = Instance.new("PointLight", domainSphere)
    l.Color, l.Range, l.Brightness = Color3.fromRGB(220, 100, 255), R, 10

    task.spawn(function()
        for i = 1, 40 do
            if not domainSphere or not domainSphere.Parent then break end
            local alpha = i / 40
            local smoothAlpha = 1 - math.pow(1 - alpha, 2)
            local currentSize = smoothAlpha * (R * 2)
            domainSphere.Size = Vector3.new(currentSize, currentSize, currentSize)
            task.wait(0.03)
        end
        if domainSphere then
            domainSphere.Size = Vector3.new(R * 2, R * 2, R * 2)
        end
    end)

    local orbitingOrbs = {}
    local ringsConfig = {
        { count = 12, speed = 0.7,   radiusFactor = 0.98, heightOffset = 2,   dir = 1  },
        { count = 10, speed = -0.9,  radiusFactor = 0.85, heightOffset = R*0.5, dir = -1 },
        { count = 10, speed = 1.1,   radiusFactor = 0.85, heightOffset = -R*0.5, dir = 1  }
    }

    for _, config in ipairs(ringsConfig) do
        for i = 1, config.count do
            local orb = Instance.new("Part", folder)
            orb.Shape = Enum.PartType.Ball
            orb.Material = Enum.Material.Neon
            orb.Color = (i % 2 == 0) and Color3.fromRGB(240, 150, 255) or Color3.fromRGB(180, 220, 255)
            orb.Anchored = true
            orb.CanCollide = false
            orb.Size = Vector3.new(4.5, 4.5, 4.5)
            
            local orbLight = Instance.new("PointLight", orb)
            orbLight.Color, orbLight.Range, orbLight.Brightness = orb.Color, 18, 4
            
            table.insert(orbitingOrbs, {
                part = orb, 
                angleOffset = i * (6.28 / config.count), 
                speed = config.speed, 
                radiusFactor = config.radiusFactor,
                heightOffset = config.heightOffset,
                dir = config.dir
            })
        end
    end

    local tickC = 0
    conn = RS.RenderStepped:Connect(function(dt)
        if not folder or not folder.Parent then if conn then conn:Disconnect() end return end
        tickC = tickC + dt
        
        for _, item in ipairs(orbitingOrbs) do
            if item.part and item.part.Parent then
                local currentAngle = (tickC * item.speed * item.dir) + item.angleOffset
                local orbitRadius = R * item.radiusFactor
                
                local posX = tPos.X + math.cos(currentAngle) * orbitRadius
                local posY = tPos.Y + item.heightOffset + math.sin(tickC * 2 + item.angleOffset) * (R * 0.15)
                local posZ = tPos.Z + math.sin(currentAngle) * orbitRadius
                
                item.part.Position = Vector3.new(posX, posY, posZ)
            end
        end
    end)

    SetState("READY")
end
