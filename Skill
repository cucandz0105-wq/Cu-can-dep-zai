ThrowFlower = function(tPos)
    if flying or workspace:FindFirstChild("FlorentinoFlowers") then return end
    local char, hrp = LP.Character, LP.Character and LP.Character:FindFirstChild("HumanoidRootPart")
    if not hrp then return end
    flying = true
    
    SetState("LOCKED")

    local proj = Instance.new("Part", workspace)
    proj.Shape, proj.Size, proj.Position, proj.Material, proj.Color, proj.CanCollide = Enum.PartType.Ball, Vector3.new(2.8, 2.8, 2.8), hrp.Position + Vector3.new(0, 1.5, 0), Enum.Material.Neon, Color3.fromRGB(220, 50, 255), false
    Instance.new("PointLight", proj).Color, proj.PointLight.Range, proj.PointLight.Brightness = Color3.fromRGB(220, 50, 255), 14, 6
    local a0, a1 = Instance.new("Attachment", proj), Instance.new("Attachment", proj)
    a0.Position, a1.Position = Vector3.new(0, 0, 1.4), Vector3.new(0, 0, -1.4)
    local tr = Instance.new("Trail", proj)
    tr.Attachment0, tr.Attachment1, tr.Color, tr.Lifetime = a0, a1, ColorSequence.new(Color3.fromRGB(255, 100, 255), Color3.fromRGB(150, 0, 255)), 0.3
    local bv = Instance.new("BodyVelocity", proj)
    bv.Velocity, bv.MaxForce = (tPos - proj.Position).Unit * PS, Vector3.new(math.huge, math.huge, math.huge)

    local hitConn
    hitConn = proj.Touched:Connect(function(hit)
        if hit:IsDescendantOf(char) then return end
        if hitConn then hitConn:Disconnect() end
        flying = false
        local hPos = proj.Position
        proj:Destroy()
        SpawnFlowers(hPos, (tPos - hrp.Position).Unit)
    end)

    task.delay(6, function()
        if flying then
            flying = false
            if hitConn then hitConn:Disconnect() end
            if proj and proj.Parent then proj:Destroy() end
            if state == "LOCKED" then SetState("OFF") end
        end
    end)
end

local function GetNearestFlower()
    local f = workspace:FindFirstChild("FlorentinoFlowers")
    local hrp = LP.Character and LP.Character:FindFirstChild("HumanoidRootPart")
    if not f or not hrp then return nil end
    return f:FindFirstChild("PurpleFlower")
end

DoCombo = function()
    if combo then return end
    local char, hrp = LP.Character, LP.Character and LP.Character:FindFirstChild("HumanoidRootPart")
    local domainObj = GetNearestFlower()
    if not char or not hrp or not domainObj or not folder or not centerPos then combo = false; return end

    local myDistToCenter = (hrp.Position - centerPos).Magnitude
    if myDistToCenter > R then return end

    local eHRP = GetNearestPInsideDomain(centerPos, R)
    if not eHRP then return end

    combo = true

    local noclip = RS.Stepped:Connect(function()
        local c = LP.Character
        if c then
            for _, p in ipairs(c:GetDescendants()) do 
                if p:IsA("BasePart") then p.CanCollide = false end 
            end
        end
    end)

    local bv = Instance.new("BodyVelocity", hrp)
    bv.MaxForce = Vector3.new(math.huge, math.huge, math.huge)
    
    while eHRP and eHRP.Parent and workspace:FindFirstChild("FlorentinoFlowers") and centerPos do
        if (eHRP.Position - centerPos).Magnitude > R then 
            break 
        end

        if (hrp.Position - eHRP.Position).Magnitude <= 5 then 
            break 
        end

        hrp.CFrame = CFrame.lookAt(hrp.Position, eHRP.Position)
        bv.Velocity = (eHRP.Position - hrp.Position).Unit * 50
        task.wait(0.01)
    end
    bv:Destroy()

    if noclip then noclip:Disconnect() end

    local isDomainStillActive = workspace:FindFirstChild("FlorentinoFlowers") and centerPos
    local isTargetStillValid = eHRP and eHRP.Parent and (eHRP.Position - centerPos).Magnitude <= R

    if isDomainStillActive and isTargetStillValid then
        local eHum = eHRP.Parent:FindFirstChild("Humanoid")
        local predictPos = eHRP.Position
        
        if eHum and eHRP:IsA("BasePart") then
            local targetVelocity = eHRP.AssemblyLinearVelocity or Vector3.new(0, 0, 0)
            predictPos = eHRP.Position + (Vector3.new(targetVelocity.X, 0, targetVelocity.Z) * 0.3)
        end

        hrp.CFrame = CFrame.new(predictPos + (eHRP.CFrame.LookVector * 2.5), predictPos)

        local sw = char:FindFirstChild("Sword")
        if sw and sw:FindFirstChild("ToolFolder") and sw.ToolFolder.Remotes:FindFirstChild("SlashRem") then
            sw.ToolFolder.Remotes.SlashRem:FireServer()
            lastSlash = os.clock()
        end

        task.wait(0.6)

        if hrp and eHRP and eHRP.Parent then
            local backPos = eHRP.Position - ((eHRP.Position - hrp.Position).Unit * 15)
            hrp.CFrame = CFrame.new(backPos, eHRP.Position)
        end
    end
    
    if workspace:FindFirstChild("FlorentinoFlowers") then
        SetState("READY")
    else
        SetState("OFF")
    end
    
    task.wait(0.05)
    combo = false
end

Mouse.Button1Down:Connect(function()
    if state == "ON" and Mouse.Hit then ThrowFlower(Mouse.Hit.Position) end
end)

